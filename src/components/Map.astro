---
import { CATEGORIES, TOWN_BOARDS, TOWN_CENTER, MAP_RADIUS } from '../lib/map/categories';

interface Props {
	variant?: 'full' | 'teaser';
	id?: string;
	latitude?: number;
	longitude?: number;
	zoom?: number;
	radius?: number;
}

const {
	variant = 'full',
	id = variant === 'teaser' ? 'vasad-map-teaser' : 'vasad-map',
	latitude = TOWN_CENTER.lat,
	longitude = TOWN_CENTER.lon,
	zoom = 13,
	radius = MAP_RADIUS,
} = Astro.props;

const icons: Record<string, string> = {
	all: '<svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="5" cy="5" r="2.2"/><circle cx="15" cy="5" r="2.2"/><circle cx="5" cy="15" r="2.2"/><circle cx="15" cy="15" r="2.2"/></g></svg>',
	rail: '<svg viewBox="0 -960 960 960" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M297.5-422.5Q280-405 280-380t17.5 42.5Q315-320 340-320t42.5-17.5Q400-355 400-380t-17.5-42.5Q365-440 340-440t-42.5 17.5Zm532.5-93Q880-471 880-400v160q0 33-23.5 56.5T800-160l80 80H520l80-80q-33 0-56.5-23.5T520-240v-160q0-71 50-115.5T700-560q80 0 130 44.5ZM679-291q-9 9-9 21t9 21q9 9 21 9t21-9q9-9 9-21t-9-21q-9-9-21-9t-21 9Zm-91-149q-4 9-6 19t-2 21v40h240v-40q0-11-2-21t-6-19H588ZM480-880q172 0 246 37t74 123v96q-18-6-38-9.5t-42-5.5v-41H240v120h260q-16 17-27.5 37T453-480H240v120q0 33 23.5 56.5T320-280h120v80H320v40q0 17-11.5 28.5T280-120h-40q-17 0-28.5-11.5T200-160v-82q-18-20-29-44.5T160-340v-380q0-83 77-121.5T480-880Zm2 120h224-448 224Zm-224 0h448q-15-17-64.5-28.5T482-800q-107 0-156.5 12.5T258-760Zm195 280Z"/></svg>',
	sacred:
		'<svg viewBox="0 -960 960 960" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M160-80v-366q-52-13-86-55t-34-98h80q0 32 23.5 55.5T199-520h41v-86q-52-13-86-55t-34-98h80q0 32 23.5 55.5T279-680h21l180-240 180 240h21q32 0 55.5-23.5T760-759h80q0 56-34 98t-86 55v86h41q32 0 55.5-23.5T840-599h80q0 56-34 98t-86 55v366H520v-160q0-17-11.5-28.5T480-280q-17 0-28.5 11.5T440-240v160H160Zm240-600h160l-80-107-80 107Zm-80 160h320v-80H320v80Zm-80 360h120v-80q0-50 35-85t85-35q50 0 85 35t35 85v80h120v-280H240v280Zm240-280Zm0-240Zm0 160Z"/></svg>',
	stay: '<svg viewBox="0 -960 960 960" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M40-200v-600h80v400h320v-320h320q66 0 113 47t47 113v360h-80v-120H120v120H40Zm155-275q-35-35-35-85t35-85q35-35 85-35t85 35q35 35 35 85t-35 85q-35 35-85 35t-85-35Zm325 75h320v-160q0-33-23.5-56.5T760-640H520v240ZM308.5-531.5Q320-543 320-560t-11.5-28.5Q297-600 280-600t-28.5 11.5Q240-577 240-560t11.5 28.5Q263-520 280-520t28.5-11.5ZM280-560Zm240-80v240-240Z"/></svg>',
	health:
		'<svg viewBox="0 -960 960 960" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M420-340h120v-100h100v-120H540v-100H420v100H320v120h100v100Zm60 260q-139-35-229.5-159.5T160-516v-244l320-120 320 120v244q0 152-90.5 276.5T480-80Zm0-84q104-33 172-132t68-220v-189l-240-90-240 90v189q0 121 68 220t172 132Zm0-316Z"/></svg>',
	study:
		'<svg viewBox="0 -960 960 960" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M480-120 200-272v-240L40-600l440-240 440 240v320h-80v-276l-80 44v240L480-120Zm0-332 274-148-274-148-274 148 274 148Zm0 241 200-108v-151L480-360 280-470v151l200 108Zm0-241Zm0 90Zm0 0Z"/></svg>',
	mill: '<svg viewBox="0 -960 960 960" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M80-80v-481l280-119v80l200-80v120h320v480H80Zm80-80h640v-320H480v-82l-200 80v-78l-120 53v347Zm280-80h80v-160h-80v160Zm-160 0h80v-160h-80v160Zm320 0h80v-160h-80v160Zm280-320H680l40-320h120l40 320ZM160-160h640-640Z"/></svg>',
	atm: '<svg viewBox="0 -960 960 960" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M415-360v-180h-90v-60h240v60h-90v180h-60Zm-335 0v-200q0-17 11.5-28.5T120-600h120q17 0 28.5 11.5T280-560v200h-60v-60h-80v60H80Zm60-120h80v-60h-80v60Zm480 120v-200q0-17 11.5-28.5T660-600h180q17 0 28.5 11.5T880-560v200h-60v-180h-40v140h-60v-140h-40v180h-60Z"/></svg>',
	bank: '<svg viewBox="0 -960 960 960" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M200-280v-280h80v280h-80Zm240 0v-280h80v280h-80ZM80-120v-80h800v80H80Zm600-160v-280h80v280h-80ZM80-640v-80l400-200 400 200v80H80Zm178-80h444-444Zm0 0h444L480-830 258-720Z"/></svg>',
	fuel: '<svg viewBox="0 -960 960 960" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M160-120v-640q0-33 23.5-56.5T240-840h240q33 0 56.5 23.5T560-760v280h40q33 0 56.5 23.5T680-400v180q0 17 11.5 28.5T720-180q17 0 28.5-11.5T760-220v-288q-9 5-19 6.5t-21 1.5q-42 0-71-29t-29-71q0-32 17.5-57.5T684-694l-84-84 42-42 148 144q15 15 22.5 35t7.5 41v380q0 42-29 71t-71 29q-42 0-71-29t-29-71v-200h-60v300H160Zm80-440h240v-200H240v200Zm480 0q17 0 28.5-11.5T760-600q0-17-11.5-28.5T720-640q-17 0-28.5 11.5T680-600q0 17 11.5 28.5T720-560ZM240-200h240v-280H240v280Zm240 0H240h240Z"/></svg>',
	civic:
		'<svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2.5 3 7h14L10 2.5Z"/><path d="M4.5 9.5h11M5.5 9.5V14M10 9.5V14M14.5 9.5V14M3 16.5h14"/></g></svg>',
};
---

<div
	class:list={['townmap', variant === 'teaser' ? 'townmap-teaser' : 'townmap-full']}
	data-latitude={latitude}
	data-longitude={longitude}
	data-zoom={zoom}
	data-radius={radius}
>
	<div class="townmap-head">
		<div>
			{
				variant === 'teaser' ? (
					<>
						<h2 class="townmap-title">The town, board by board</h2>
						<p class="font-gu townmap-sub">
							નકશા પર વાસદ — {TOWN_BOARDS.length} town boards, live survey behind them
						</p>
					</>
				) : (
					<>
						<h2 class="townmap-title">Vasad on the survey map</h2>
						<p class="font-gu townmap-sub">
							નકશા પર વાસદ — town boards first, OpenStreetMap survey behind
						</p>
					</>
				)
			}
		</div>
		{
			variant === 'teaser' ? (
				<a class="townmap-link" href="/visit#map">
					Open the full map
				</a>
			) : (
				<p class="townmap-note">Drag to roam · scroll passes the page</p>
			)
		}
	</div>

	<div class="townmap-toolbar" role="group" aria-label="Map filter boards">
		<button type="button" class="board is-active" data-category="all" aria-pressed="true">
			<span class="board-ic" aria-hidden="true" set:html={icons.all}></span>
			<span class="board-en">All</span>
			<span class="font-gu board-gu">બધું</span>
		</button>
		{
			CATEGORIES.map((c) => (
				<button type="button" class="board" data-category={c.id} aria-pressed="false">
					<span class="board-ic" style={`background:${c.color};color:${c.ink}`} aria-hidden="true" set:html={icons[c.id]} />
					<span class="board-en">{c.en}</span>
					<span class="font-gu board-gu">{c.gu}</span>
				</button>
			))
		}
	</div>

	<div class="townmap-frame">
		<div id={id} class="townmap-canvas" role="application" aria-label="Interactive map of Vasad"></div>
		<p class="townmap-status" data-status role="status" aria-live="polite">
			Pinning the town boards…
		</p>
	</div>

	<div class="townmap-foot">
		<p>
			Town boards are the town’s own pins. Live places come from{' '}
			<a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a>{' '}
			via <a href="https://wiki.openstreetmap.org/wiki/Overpass_API" target="_blank" rel="noopener">Overpass</a> —{' '}
			<span data-count>{TOWN_BOARDS.length} boards</span>.
		</p>
		{
			variant === 'teaser' ? (
				<a class="plate plate-ghost townmap-cta" href="/visit#map">
					Roam the full map
				</a>
			) : (
				<a class="plate plate-ghost townmap-cta" href="/directory">
					Walk the directory
				</a>
			)
		}
	</div>
</div>

<script>
	import L from 'leaflet';
	import 'leaflet/dist/leaflet.css';
	import { CATEGORIES, TOWN_BOARDS } from '../lib/map/categories';
	import { buildOverpassQuery, toPlaces } from '../lib/map/overpass';

	const PIN_SVG: Record<string, string> = {
		rail: '<svg viewBox="0 -960 960 960" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M297.5-422.5Q280-405 280-380t17.5 42.5Q315-320 340-320t42.5-17.5Q400-355 400-380t-17.5-42.5Q365-440 340-440t-42.5 17.5Zm532.5-93Q880-471 880-400v160q0 33-23.5 56.5T800-160l80 80H520l80-80q-33 0-56.5-23.5T520-240v-160q0-71 50-115.5T700-560q80 0 130 44.5ZM679-291q-9 9-9 21t9 21q9 9 21 9t21-9q9-9 9-21t-9-21q-9-9-21-9t-21 9Zm-91-149q-4 9-6 19t-2 21v40h240v-40q0-11-2-21t-6-19H588ZM480-880q172 0 246 37t74 123v96q-18-6-38-9.5t-42-5.5v-41H240v120h260q-16 17-27.5 37T453-480H240v120q0 33 23.5 56.5T320-280h120v80H320v40q0 17-11.5 28.5T280-120h-40q-17 0-28.5-11.5T200-160v-82q-18-20-29-44.5T160-340v-380q0-83 77-121.5T480-880Zm2 120h224-448 224Zm-224 0h448q-15-17-64.5-28.5T482-800q-107 0-156.5 12.5T258-760Zm195 280Z"/></svg>',
		sacred:
			'<svg viewBox="0 -960 960 960" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M160-80v-366q-52-13-86-55t-34-98h80q0 32 23.5 55.5T199-520h41v-86q-52-13-86-55t-34-98h80q0 32 23.5 55.5T279-680h21l180-240 180 240h21q32 0 55.5-23.5T760-759h80q0 56-34 98t-86 55v86h41q32 0 55.5-23.5T840-599h80q0 56-34 98t-86 55v366H520v-160q0-17-11.5-28.5T480-280q-17 0-28.5 11.5T440-240v160H160Zm240-600h160l-80-107-80 107Zm-80 160h320v-80H320v80Zm-80 360h120v-80q0-50 35-85t85-35q50 0 85 35t35 85v80h120v-280H240v280Zm240-280Zm0-240Zm0 160Z"/></svg>',
		stay: '<svg viewBox="0 -960 960 960" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M40-200v-600h80v400h320v-320h320q66 0 113 47t47 113v360h-80v-120H120v120H40Zm155-275q-35-35-35-85t35-85q35-35 85-35t85 35q35 35 35 85t-35 85q-35 35-85 35t-85-35Zm325 75h320v-160q0-33-23.5-56.5T760-640H520v240ZM308.5-531.5Q320-543 320-560t-11.5-28.5Q297-600 280-600t-28.5 11.5Q240-577 240-560t11.5 28.5Q263-520 280-520t28.5-11.5ZM280-560Zm240-80v240-240Z"/></svg>',
		health:
			'<svg viewBox="0 -960 960 960" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M420-340h120v-100h100v-120H540v-100H420v100H320v120h100v100Zm60 260q-139-35-229.5-159.5T160-516v-244l320-120 320 120v244q0 152-90.5 276.5T480-80Zm0-84q104-33 172-132t68-220v-189l-240-90-240 90v189q0 121 68 220t172 132Zm0-316Z"/></svg>',
		study:
			'<svg viewBox="0 -960 960 960" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M480-120 200-272v-240L40-600l440-240 440 240v320h-80v-276l-80 44v240L480-120Zm0-332 274-148-274-148-274 148 274 148Zm0 241 200-108v-151L480-360 280-470v151l200 108Zm0-241Zm0 90Zm0 0Z"/></svg>',
		mill: '<svg viewBox="0 -960 960 960" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M80-80v-481l280-119v80l200-80v120h320v480H80Zm80-80h640v-320H480v-82l-200 80v-78l-120 53v347Zm280-80h80v-160h-80v160Zm-160 0h80v-160h-80v160Zm320 0h80v-160h-80v160Zm280-320H680l40-320h120l40 320ZM160-160h640-640Z"/></svg>',
		atm: '<svg viewBox="0 -960 960 960" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M415-360v-180h-90v-60h240v60h-90v180h-60Zm-335 0v-200q0-17 11.5-28.5T120-600h120q17 0 28.5 11.5T280-560v200h-60v-60h-80v60H80Zm60-120h80v-60h-80v60Zm480 120v-200q0-17 11.5-28.5T660-600h180q17 0 28.5 11.5T880-560v200h-60v-180h-40v140h-60v-140h-40v180h-60Z"/></svg>',
		bank: '<svg viewBox="0 -960 960 960" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M200-280v-280h80v280h-80Zm240 0v-280h80v280h-80ZM80-120v-80h800v80H80Zm600-160v-280h80v280h-80ZM80-640v-80l400-200 400 200v80H80Zm178-80h444-444Zm0 0h444L480-830 258-720Z"/></svg>',
		fuel: '<svg viewBox="0 -960 960 960" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M160-120v-640q0-33 23.5-56.5T240-840h240q33 0 56.5 23.5T560-760v280h40q33 0 56.5 23.5T680-400v180q0 17 11.5 28.5T720-180q17 0 28.5-11.5T760-220v-288q-9 5-19 6.5t-21 1.5q-42 0-71-29t-29-71q0-32 17.5-57.5T684-694l-84-84 42-42 148 144q15 15 22.5 35t7.5 41v380q0 42-29 71t-71 29q-42 0-71-29t-29-71v-200h-60v300H160Zm80-440h240v-200H240v200Zm480 0q17 0 28.5-11.5T760-600q0-17-11.5-28.5T720-640q-17 0-28.5 11.5T680-600q0 17 11.5 28.5T720-560ZM240-200h240v-280H240v280Zm240 0H240h240Z"/></svg>',
		civic:
			'<svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2.5 3 7h14L10 2.5Z"/><path d="M4.5 9.5h11M5.5 9.5V14M10 9.5V14M14.5 9.5V14M3 16.5h14"/></g></svg>',
	};

	const COLORS = Object.fromEntries(CATEGORIES.map((c) => [c.id, c]));
	const GU = { rail: 'રેલ · બસ', sacred: 'મંદિર', stay: 'રોકાણ · ભોજન', mill: 'મિલ્સ · વેપાર', health: 'આરોગ્ય', study: 'અભ્યાસ', atm: 'એટીએમ', bank: 'બેંક', fuel: 'પેટ્રોલ · સીએનજી', civic: 'કચેરી' } as Record<string, string>;

	function pinIcon(category: string, town: boolean) {
		const c = (COLORS as Record<string, { color: string; ink: string; en: string }>)[category] ?? {
			color: '#2a2723',
			ink: '#e8a020',
			en: category,
		};
		return L.divIcon({
			className: 'town-pin-wrap',
			html: `<span class="town-pin${town ? ' is-town' : ''}" style="--pin:${c.color};--pin-ink:${c.ink}">${PIN_SVG[category] ?? ''}<span class="town-pin-dot" aria-hidden="true"></span></span>`,
			iconSize: [38, 38],
			iconAnchor: [19, 19],
			popupAnchor: [0, -20],
		});
	}

	function escapeHtml(s: string) {
		return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
	}

	async function init(root: Element) {
		const canvas = root.querySelector('.townmap-canvas') as HTMLElement | null;
		const status = root.querySelector('[data-status]') as HTMLElement | null;
		const count = root.querySelector('[data-count]') as HTMLElement | null;
		if (!canvas) return;
		const el = root as HTMLElement;
		const lat = Number(el.dataset.latitude ?? 22.45);
		const lon = Number(el.dataset.longitude ?? 73.0667);
		const zoom = Number(el.dataset.zoom ?? 13);
		const radius = Number(el.dataset.radius ?? 8000);

		const map = L.map(canvas, { scrollWheelZoom: false, attributionControl: true }).setView([lat, lon], zoom);
		map.attributionControl.setPrefix(false);
		L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
			maxZoom: 19,
			attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
		}).addTo(map);
		map.on('focus', () => map.scrollWheelZoom.enable());
		map.on('blur', () => map.scrollWheelZoom.disable());
		map.on('click', () => map.scrollWheelZoom.enable());

		const records: { marker: L.Marker; category: string }[] = [];
		const bounds = L.latLngBounds([]);

		for (const b of TOWN_BOARDS) {
			const marker = L.marker([b.lat, b.lon], { icon: pinIcon(b.category, true), title: b.en });
			marker.bindPopup(
				`<div class="town-pop"><p class="font-gu town-pop-gu">${escapeHtml(b.gu)}</p><strong>${escapeHtml(b.en)}</strong><span class="town-pop-line">${escapeHtml(b.line)}</span>${b.link ? `<a href="${b.link.href}">${escapeHtml(b.link.label)} &rarr;</a>` : ''}${b.gmaps ? `<a href="${escapeHtml(b.gmaps)}" target="_blank" rel="noopener">Google Maps &rarr;</a>` : ''}<span class="town-pop-src">Town board · surveyed</span></div>`,
			);
			marker.addTo(map);
			records.push({ marker, category: b.category });
			bounds.extend([b.lat, b.lon]);
		}
		if (bounds.isValid()) map.fitBounds(bounds.pad(0.35));

		const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('.board'));
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		/*
		 * Zoom to the pins on show — the frame travels to the category's
		 * own spread, not a fixed zoom level.
		 */
		function fitToCategories(cats: string[]) {
			const points = records
				.filter(({ category }) => cats.includes(category))
				.map(({ marker }) => marker.getLatLng());
			if (points.length === 0) return;
			map.fitBounds(L.latLngBounds(points), {
				padding: [56, 56],
				maxZoom: 15,
				animate: !reduceMotion,
			});
		}

		buttons.forEach((btn) => {
			btn.addEventListener('click', () => {
				const cat = btn.dataset.category ?? 'all';
				buttons.forEach((b) => {
					const on = b === btn;
					b.classList.toggle('is-active', on);
					b.setAttribute('aria-pressed', on ? 'true' : 'false');
				});
				records.forEach(({ marker, category }) => {
					const show = cat === 'all' || cat === category;
					if (show) marker.addTo(map);
					else map.removeLayer(marker);
				});
				fitToCategories(cat === 'all' ? records.map((r) => r.category) : [cat]);
			});
		});

		if (status) status.textContent = `${TOWN_BOARDS.length} town boards pinned · asking the live survey…`;
		try {
			const ctrl = new AbortController();
			const timer = window.setTimeout(() => ctrl.abort(), 25000);
			const res = await fetch('https://overpass-api.de/api/interpreter', {
				method: 'POST',
				headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
				body: new URLSearchParams({ data: buildOverpassQuery(lat, lon, radius) }),
				signal: ctrl.signal,
			});
			window.clearTimeout(timer);
			if (!res.ok) throw new Error(`Overpass ${res.status}`);
			const data = await res.json();
			const places = toPlaces(data.elements).slice(0, 220);
			for (const p of places) {
				const m = L.marker([p.lat, p.lon], { icon: pinIcon(p.category, false), title: p.name });
				const cat = (COLORS as Record<string, { en: string }>)[p.category];
				m.bindPopup(
					`<div class="town-pop"><p class="font-gu town-pop-gu">${escapeHtml((GU as Record<string, string>)[p.category] ?? '')}</p><strong>${escapeHtml(p.name)}</strong><span class="town-pop-line">${escapeHtml(cat?.en ?? p.category)}${p.street ? ` · ${escapeHtml(p.street)}` : ''}${p.phone ? ` · ${escapeHtml(p.phone)}` : ''}</span><a href="https://www.openstreetmap.org/${p.osmType}/${p.osmId}" target="_blank" rel="noopener">OpenStreetMap record &rarr;</a><span class="town-pop-src">Live survey · OSM</span></div>`,
				);
				records.push({ marker: m, category: p.category });
				const active = root.querySelector('.board.is-active')?.getAttribute('data-category') ?? 'all';
				if (active === 'all' || active === p.category) m.addTo(map);
			}
			if (status) status.textContent = `${TOWN_BOARDS.length} town boards · ${places.length} live places within ${Math.round(radius / 1000)} km`;
			if (count) count.textContent = `${TOWN_BOARDS.length} boards · ${places.length} live places`;
		} catch (e) {
			console.error(e);
			if (status) status.textContent = `${TOWN_BOARDS.length} town boards pinned · live survey paused — boards stay up`;
		}
	}

	document.querySelectorAll('.townmap').forEach((root) => {
		const el = root as HTMLElement;
		if (el.dataset.ready === 'true') return;
		el.dataset.ready = 'true';
		void init(root);
	});
</script>


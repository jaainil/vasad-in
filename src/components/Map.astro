---
import { CATEGORIES, TOWN_BOARDS, TOWN_CENTER, MAP_RADIUS } from '../lib/map/categories';

interface Props {
	variant?: 'full' | 'teaser';
	id?: string;
	latitude?: number;
	longitude?: number;
	zoom?: number;
	radius?: number;
}

const {
	variant = 'full',
	id = variant === 'teaser' ? 'vasad-map-teaser' : 'vasad-map',
	latitude = TOWN_CENTER.lat,
	longitude = TOWN_CENTER.lon,
	zoom = 13,
	radius = MAP_RADIUS,
} = Astro.props;

const icons: Record<string, string> = {
	all: '<svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="5" cy="5" r="2.2"/><circle cx="15" cy="5" r="2.2"/><circle cx="5" cy="15" r="2.2"/><circle cx="15" cy="15" r="2.2"/></g></svg>',
	rail: '<svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2.5" width="10" height="9" rx="2"/><path d="M5 8.5h10M7.5 14.5 5.5 18M12.5 14.5l2 3.5M7 18h6"/></g></svg>',
	sacred:
		'<svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2.5 4.5 9h11L10 2.5Z"/><path d="M6 9v4M10 9v4M14 9v4M3.5 15.5h13M2.5 18h15"/></g></svg>',
	stay: '<svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 9.5 10 3l7.5 6.5"/><path d="M5 8.5V17h10V8.5"/><path d="M8 17v-4h4v4"/></g></svg>',
	health:
		'<svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="10" cy="10" r="7.5"/><path d="M10 6.5v7M6.5 10h7"/></g></svg>',
	study:
		'<svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10 3 2.5 6.5 10 10l7.5-3.5L10 3Z"/><path d="M5 8v4.5c0 1.5 2.2 2.7 5 2.7s5-1.2 5-2.7V8"/><path d="M15.5 6.5V13"/></g></svg>',
	mill: '<svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17.5V8.5l4.5 3v-3l4.5 3v-3l5 3.2v2.8Z"/><path d="M6 8.5V4.5h2.5v4"/></g></svg>',
	services:
		'<svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2.5 3 7h14L10 2.5Z"/><path d="M4.5 9.5h11M5.5 9.5V14M10 9.5V14M14.5 9.5V14M3 16.5h14"/></g></svg>',
};
---

<div
	class:list={['townmap', variant === 'teaser' ? 'townmap-teaser' : 'townmap-full']}
	data-latitude={latitude}
	data-longitude={longitude}
	data-zoom={zoom}
	data-radius={radius}
>
	<div class="townmap-head">
		<div>
			{
				variant === 'teaser' ? (
					<>
						<h2 class="townmap-title">The town, board by board</h2>
						<p class="font-gu townmap-sub">
							નકશા પર વાસદ — {TOWN_BOARDS.length} town boards, live survey behind them
						</p>
					</>
				) : (
					<>
						<h2 class="townmap-title">Vasad on the survey map</h2>
						<p class="font-gu townmap-sub">
							નકશા પર વાસદ — town boards first, OpenStreetMap survey behind
						</p>
					</>
				)
			}
		</div>
		{
			variant === 'teaser' ? (
				<a class="townmap-link" href="/visit#map">
					Open the full map
				</a>
			) : (
				<p class="townmap-note">Drag to roam · scroll passes the page</p>
			)
		}
	</div>

	<div class="townmap-toolbar" role="group" aria-label="Map filter boards">
		<button type="button" class="board is-active" data-category="all" aria-pressed="true">
			<span class="board-ic" aria-hidden="true" set:html={icons.all}></span>
			<span class="board-en">All</span>
			<span class="font-gu board-gu">બધું</span>
		</button>
		{
			CATEGORIES.map((c) => (
				<button type="button" class="board" data-category={c.id} aria-pressed="false">
					<span class="board-ic" style={`background:${c.color};color:${c.ink}`} aria-hidden="true" set:html={icons[c.id]} />
					<span class="board-en">{c.en}</span>
					<span class="font-gu board-gu">{c.gu}</span>
				</button>
			))
		}
	</div>

	<div class="townmap-frame">
		<div id={id} class="townmap-canvas" role="application" aria-label="Interactive map of Vasad"></div>
		<p class="townmap-status" data-status role="status" aria-live="polite">
			Pinning the town boards…
		</p>
	</div>

	<div class="townmap-foot">
		<p>
			Town boards are the town’s own pins. Live places come from{' '}
			<a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a>{' '}
			via <a href="https://wiki.openstreetmap.org/wiki/Overpass_API" target="_blank" rel="noopener">Overpass</a> —{' '}
			<span data-count>{TOWN_BOARDS.length} boards</span>.
		</p>
		{
			variant === 'teaser' ? (
				<a class="plate plate-ghost townmap-cta" href="/visit#map">
					Roam the full map
				</a>
			) : (
				<a class="plate plate-ghost townmap-cta" href="/directory">
					Walk the directory
				</a>
			)
		}
	</div>
</div>

<script>
	import L from 'leaflet';
	import 'leaflet/dist/leaflet.css';
	import { CATEGORIES, TOWN_BOARDS } from '../lib/map/categories';
	import { buildOverpassQuery, toPlaces } from '../lib/map/overpass';

	const PIN_SVG: Record<string, string> = {
		rail: '<svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2.5" width="10" height="9" rx="2"/><path d="M5 8.5h10M7.5 14.5 5.5 18M12.5 14.5l2 3.5M7 18h6"/></g></svg>',
		sacred:
			'<svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2.5 4.5 9h11L10 2.5Z"/><path d="M6 9v4M10 9v4M14 9v4M3.5 15.5h13M2.5 18h15"/></g></svg>',
		stay: '<svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 9.5 10 3l7.5 6.5"/><path d="M5 8.5V17h10V8.5"/><path d="M8 17v-4h4v4"/></g></svg>',
		health:
			'<svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="10" cy="10" r="7.5"/><path d="M10 6.5v7M6.5 10h7"/></g></svg>',
	study:
		'<svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10 3 2.5 6.5 10 10l7.5-3.5L10 3Z"/><path d="M5 8v4.5c0 1.5 2.2 2.7 5 2.7s5-1.2 5-2.7V8"/><path d="M15.5 6.5V13"/></g></svg>',
	mill: '<svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17.5V8.5l4.5 3v-3l4.5 3v-3l5 3.2v2.8Z"/><path d="M6 8.5V4.5h2.5v4"/></g></svg>',
	services:
		'<svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2.5 3 7h14L10 2.5Z"/><path d="M4.5 9.5h11M5.5 9.5V14M10 9.5V14M14.5 9.5V14M3 16.5h14"/></g></svg>',
};

	const COLORS = Object.fromEntries(CATEGORIES.map((c) => [c.id, c]));
	const GU = { rail: 'રેલ · બસ', sacred: 'મંદિર', stay: 'રોકાણ · ભોજન', mill: 'મિલ્સ · વેપાર', health: 'આરોગ્ય', study: 'અભ્યાસ', services: 'બેંક · પેટ્રોલ' } as Record<string, string>;

	function pinIcon(category: string, town: boolean) {
		const c = (COLORS as Record<string, { color: string; ink: string; en: string }>)[category] ?? {
			color: '#2a2723',
			ink: '#e8a020',
			en: category,
		};
		return L.divIcon({
			className: 'town-pin-wrap',
			html: `<span class="town-pin${town ? ' is-town' : ''}" style="--pin:${c.color};--pin-ink:${c.ink}">${PIN_SVG[category] ?? ''}<span class="town-pin-dot" aria-hidden="true"></span></span>`,
			iconSize: [38, 38],
			iconAnchor: [19, 19],
			popupAnchor: [0, -20],
		});
	}

	function escapeHtml(s: string) {
		return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
	}

	async function init(root: Element) {
		const canvas = root.querySelector('.townmap-canvas') as HTMLElement | null;
		const status = root.querySelector('[data-status]') as HTMLElement | null;
		const count = root.querySelector('[data-count]') as HTMLElement | null;
		if (!canvas) return;
		const el = root as HTMLElement;
		const lat = Number(el.dataset.latitude ?? 22.45);
		const lon = Number(el.dataset.longitude ?? 73.0667);
		const zoom = Number(el.dataset.zoom ?? 13);
		const radius = Number(el.dataset.radius ?? 8000);

		const map = L.map(canvas, { scrollWheelZoom: false, attributionControl: true }).setView([lat, lon], zoom);
		map.attributionControl.setPrefix(false);
		L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
			maxZoom: 19,
			attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
		}).addTo(map);
		map.on('focus', () => map.scrollWheelZoom.enable());
		map.on('blur', () => map.scrollWheelZoom.disable());
		map.on('click', () => map.scrollWheelZoom.enable());

		const records: { marker: L.Marker; category: string }[] = [];
		const bounds = L.latLngBounds([]);

		for (const b of TOWN_BOARDS) {
			const marker = L.marker([b.lat, b.lon], { icon: pinIcon(b.category, true), title: b.en });
			marker.bindPopup(
				`<div class="town-pop"><p class="font-gu town-pop-gu">${escapeHtml(b.gu)}</p><strong>${escapeHtml(b.en)}</strong><span class="town-pop-line">${escapeHtml(b.line)}</span>${b.link ? `<a href="${b.link.href}">${escapeHtml(b.link.label)} &rarr;</a>` : ''}${b.gmaps ? `<a href="${escapeHtml(b.gmaps)}" target="_blank" rel="noopener">Google Maps &rarr;</a>` : ''}<span class="town-pop-src">Town board · surveyed</span></div>`,
			);
			marker.addTo(map);
			records.push({ marker, category: b.category });
			bounds.extend([b.lat, b.lon]);
		}
		if (bounds.isValid()) map.fitBounds(bounds.pad(0.35));

		const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('.board'));
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		/*
		 * Zoom to the pins on show — the frame travels to the category's
		 * own spread, not a fixed zoom level.
		 */
		function fitToCategories(cats: string[]) {
			const points = records
				.filter(({ category }) => cats.includes(category))
				.map(({ marker }) => marker.getLatLng());
			if (points.length === 0) return;
			map.fitBounds(L.latLngBounds(points), {
				padding: [56, 56],
				maxZoom: 15,
				animate: !reduceMotion,
			});
		}

		buttons.forEach((btn) => {
			btn.addEventListener('click', () => {
				const cat = btn.dataset.category ?? 'all';
				buttons.forEach((b) => {
					const on = b === btn;
					b.classList.toggle('is-active', on);
					b.setAttribute('aria-pressed', on ? 'true' : 'false');
				});
				records.forEach(({ marker, category }) => {
					const show = cat === 'all' || cat === category;
					if (show) marker.addTo(map);
					else map.removeLayer(marker);
				});
				fitToCategories(cat === 'all' ? records.map((r) => r.category) : [cat]);
			});
		});

		if (status) status.textContent = `${TOWN_BOARDS.length} town boards pinned · asking the live survey…`;
		try {
			const ctrl = new AbortController();
			const timer = window.setTimeout(() => ctrl.abort(), 25000);
			const res = await fetch('https://overpass-api.de/api/interpreter', {
				method: 'POST',
				headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
				body: new URLSearchParams({ data: buildOverpassQuery(lat, lon, radius) }),
				signal: ctrl.signal,
			});
			window.clearTimeout(timer);
			if (!res.ok) throw new Error(`Overpass ${res.status}`);
			const data = await res.json();
			const places = toPlaces(data.elements).slice(0, 220);
			for (const p of places) {
				const m = L.marker([p.lat, p.lon], { icon: pinIcon(p.category, false), title: p.name });
				const cat = (COLORS as Record<string, { en: string }>)[p.category];
				m.bindPopup(
					`<div class="town-pop"><p class="font-gu town-pop-gu">${escapeHtml((GU as Record<string, string>)[p.category] ?? '')}</p><strong>${escapeHtml(p.name)}</strong><span class="town-pop-line">${escapeHtml(cat?.en ?? p.category)}${p.street ? ` · ${escapeHtml(p.street)}` : ''}${p.phone ? ` · ${escapeHtml(p.phone)}` : ''}</span><a href="https://www.openstreetmap.org/${p.osmType}/${p.osmId}" target="_blank" rel="noopener">OpenStreetMap record &rarr;</a><span class="town-pop-src">Live survey · OSM</span></div>`,
				);
				records.push({ marker: m, category: p.category });
				const active = root.querySelector('.board.is-active')?.getAttribute('data-category') ?? 'all';
				if (active === 'all' || active === p.category) m.addTo(map);
			}
			if (status) status.textContent = `${TOWN_BOARDS.length} town boards · ${places.length} live places within ${Math.round(radius / 1000)} km`;
			if (count) count.textContent = `${TOWN_BOARDS.length} boards · ${places.length} live places`;
		} catch (e) {
			console.error(e);
			if (status) status.textContent = `${TOWN_BOARDS.length} town boards pinned · live survey paused — boards stay up`;
		}
	}

	document.querySelectorAll('.townmap').forEach((root) => {
		const el = root as HTMLElement;
		if (el.dataset.ready === 'true') return;
		el.dataset.ready = 'true';
		void init(root);
	});
</script>

<style>
	.townmap {
		position: relative;
		border: 3px solid var(--color-ink);
		border-radius: 14px;
		background: var(--color-cream-hi);
		box-shadow: var(--shadow-paint);
		padding: clamp(1.1rem, 3vw, 1.9rem);
		overflow: hidden;
	}
	.townmap::before,
	.townmap::after {
		content: '';
		position: absolute;
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: var(--color-rivet);
		border: 2px solid var(--color-ink);
		z-index: 5;
	}
	.townmap::before { top: 10px; left: 10px; }
	.townmap::after { top: 10px; right: 10px; }
	.townmap-head {
		display: flex;
		flex-wrap: wrap;
		align-items: end;
		justify-content: space-between;
		gap: 0.8rem 1.5rem;
		margin-bottom: 1rem;
	}
	.townmap-title {
		font-size: clamp(1.6rem, 3vw, 2.1rem);
	}
	.townmap-sub { margin-top: 0.3rem; color: rgb(42 39 35 / 0.78); }
	.townmap-link, .townmap-note {
		font-family: var(--font-display);
		font-size: 0.98rem;
	}
	.townmap-note { color: rgb(42 39 35 / 0.7); margin: 0; }
	.townmap-link {
		border: 2.5px solid var(--color-ink);
		border-radius: 9px;
		padding: 0.45rem 0.9rem;
		background: var(--color-mustard);
		color: var(--color-ink);
		text-decoration: none;
	}
	.townmap-toolbar {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
		margin-bottom: 1rem;
	}
	.board {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		border: 2.5px solid var(--color-ink);
		border-radius: 999px;
		background: var(--color-cream);
		color: var(--color-ink);
		padding: 0.38rem 0.8rem 0.38rem 0.42rem;
		font-size: 0.92rem;
		font-weight: 600;
		cursor: pointer;
		transition: transform 0.3s cubic-bezier(0.22,1,0.36,1), background-color 0.2s ease-out;
	}
	.board:hover { transform: translateY(-2px); background: var(--color-mustard); }
	.board.is-active { background: var(--color-ink); color: var(--color-cream); }
	.board-ic {
		display: inline-grid;
		place-items: center;
		width: 28px;
		height: 28px;
		border-radius: 50%;
		border: 2px solid var(--color-ink);
		background: var(--color-cream-hi);
		color: var(--color-ink);
	}
	.board-gu { font-size: 0.8rem; font-weight: 700; opacity: 0.85; }
	.townmap-frame { position: relative; }
	.townmap-canvas {
		width: 100%;
		height: 560px;
		border: 3px solid var(--color-ink);
		border-radius: 12px;
		overflow: hidden;
		background: #e7dcc3;
		z-index: 1;
	}
	.townmap-teaser .townmap-canvas { height: 380px; }
	.townmap-status {
		position: absolute;
		right: 12px;
		bottom: 12px;
		z-index: 500;
		margin: 0;
		padding: 0.45rem 0.75rem;
		border: 2.5px solid var(--color-ink);
		border-radius: 8px;
		background: var(--color-cream-hi);
		font-size: 0.82rem;
		font-weight: 600;
		max-width: min(78%, 340px);
	}
	.townmap-foot {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.9rem 1.4rem;
		margin-top: 1rem;
	}
	.townmap-foot p { margin: 0; font-size: 0.92rem; color: rgb(42 39 35 / 0.82); max-width: 62ch; }
	.townmap-cta { font-size: 1rem; padding: 0.65rem 1.3rem; }

	:global(.town-pin-wrap) { background: transparent; border: 0; }
	:global(.town-pin) {
		width: 38px;
		height: 38px;
		display: grid;
		place-items: center;
		border-radius: 50%;
		background: var(--pin);
		color: var(--pin-ink);
		border: 3px solid var(--color-ink);
		box-shadow: 0 10px 18px -12px rgb(42 39 35 / 0.65);
		position: relative;
	}
	:global(.town-pin.is-town::after) {
		content: '';
		position: absolute;
		inset: -7px;
		border: 2px dashed var(--color-ink);
		border-radius: 50%;
		opacity: 0.65;
	}
	:global(.leaflet-container) {
		font-family: var(--font-body);
		background: #e7dcc3;
	}
	:global(.leaflet-control-zoom a),
	:global(.leaflet-control-attribution) {
		background: var(--color-cream-hi) !important;
		color: var(--color-ink) !important;
		border-color: var(--color-ink) !important;
	}
	:global(.leaflet-control-attribution a) { color: var(--color-lacquer-deep) !important; }
	:global(.leaflet-popup-content-wrapper) {
		border: 3px solid var(--color-ink);
		border-radius: 10px;
		background: var(--color-cream-hi);
		color: var(--color-ink);
		box-shadow: var(--shadow-paint);
	}
	:global(.leaflet-popup-tip) {
		background: var(--color-cream-hi);
		border: 3px solid var(--color-ink);
	}
	:global(.leaflet-popup-content) { margin: 0.85rem 1rem; line-height: 1.45; }
	:global(.town-pop) { min-width: 190px; max-width: 240px; display: flex; flex-direction: column; gap: 0.25rem; }
	:global(.town-pop strong) { font-family: var(--font-display); font-weight: 400; font-size: 1.02rem; }
	:global(.town-pop-gu) { margin: 0; font-size: 0.82rem; font-weight: 700; color: var(--color-lacquer); }
	:global(.town-pop-line) { font-size: 0.86rem; color: rgb(42 39 35 / 0.85); }
	:global(.town-pop a) { font-size: 0.86rem; font-weight: 700; }
	:global(.town-pop-src) { font-size: 0.74rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: rgb(42 39 35 / 0.6); }

	@media (max-width: 640px) {
		.townmap-canvas, .townmap-teaser .townmap-canvas { height: 420px; }
		.board-gu { display: none; }
	}
</style>

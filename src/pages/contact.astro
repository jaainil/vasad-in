---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const council = [
	['Sarpanch', 'Poonambhai D. Parmar'],
	['Deputy Sarpanch', 'Deepbhai P. Patel'],
	['Constituencies', 'Anklav Vidhan Sabha · Anand Lok Sabha'],
	['Address', 'Panchayat Bhavan, Vasad 388306, Anand, Gujarat'],
	['Position', '22.45°N 73.0667°E — on NH 48, 15 km south of Anand'],
];

const services = [
	{
		en: 'Drinking water & borewell supply',
		line: 'Filtered groundwater to every ward from 8-lakh-litre overhead storage.',
		when: 'Morning 6:00 – 8:30 · Evening 5:30 – 7:30',
	},
	{
		en: 'Sanitation & Swachh Bharat cell',
		line: 'Door-to-door collection and segregated composting across 3,047 households.',
		when: 'Daily 7:00 am – 2:00 pm',
	},
	{
		en: 'Birth, death & marriage registry',
		line: 'Computer-generated civil certificates under the Gujarat Panchayats Act.',
		when: 'Mon – Sat 10:30 am – 5:30 pm',
	},
	{
		en: 'Land records & e-Gram desk',
		line: '7/12 and 8A records, subsidy help for dal and banana growers, citizen verification.',
		when: 'Mon – Sat 11:00 am – 4:00 pm',
	},
];

const lines = [
	{ en: 'Gram Panchayat Bhavan', line: 'Civic office', tel: '02692 274220', href: 'tel:+912692274220' },
	{ en: 'Primary Health Centre', line: 'Emergency health · 108', tel: '02692 274102', href: 'tel:+912692274102' },
	{ en: 'Vasad Police Station', line: 'Law & order · 100', tel: '02692 274333', href: 'tel:+912692274333' },
	{ en: 'MGVCL Power Substation', line: 'Electricity · 19122', tel: '02692 274411', href: 'tel:+912692274411' },
	{ en: 'Vasad Jn. Railway help', line: 'Rail transit · 139', tel: 'WR helpdesk', href: '/visit#reach' },
];
---

<Layout
	title="The Panchayat Office — Vasad | સંપર્ક"
	description="Contact Vasad's gram panchayat: the elected council, service counters and schedules, and the town's emergency phone lines."
>
	<Nav />
	<main id="main" class="wrap">
		<header class="pt-12">
			<h1 class="text-[clamp(2.3rem,5vw,3.4rem)]">The panchayat office</h1>
			<p class="gu mt-1.5 text-[1.1rem] text-ink/80">સંપર્ક — the town’s front desk</p>
		</header>

		<section class="panel riveted mt-10 px-8 pb-8 pt-8" aria-labelledby="gp-h">
			<h2 id="gp-h" class="text-[clamp(1.6rem,3vw,2.2rem)]">Gram Panchayat Vasad</h2>
			<dl class="mt-4">
				{council.map(([k, v]) => (
					<div class="row">
						<dt>{k}</dt>
						<dd>{v}</dd>
					</div>
				))}
			</dl>
		</section>

		<section class="mt-12" aria-labelledby="counters-h">
			<h2 id="counters-h" class="text-[clamp(1.6rem,3vw,2.2rem)]">The citizen counters</h2>
			<div class="mt-6 grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-6">
				{services.map((s) => (
					<div class="panel riveted flex flex-col gap-1 px-6 py-5">
						<span class="font-display text-[1.15rem]">{s.en}</span>
						<span class="text-[0.93rem] text-ink/85">{s.line}</span>
						<span class="mt-1.5 text-[0.85rem] font-semibold text-lacquer">{s.when}</span>
					</div>
				))}
			</div>
			<p class="officenote mt-6 max-w-[68ch] text-ink/80">
				Statutory work — certificates, property tax, water connections, NOCs — is processed
				at the Panchayat Bhavan counters, Monday to Saturday, 10:30 am to 5:30 pm.
			</p>
		</section>

		<section class="mt-12" aria-labelledby="lines-h">
			<h2 id="lines-h" class="text-[clamp(1.6rem,3vw,2.2rem)]">Emergency lines</h2>
			<div class="mt-6 grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-5">
				{lines.map((l) => (
					<a
						class="flex flex-col gap-0.5 rounded-[10px] border-[3px] border-ink bg-cream-hi px-5 py-4 no-underline shadow-paint transition-[transform,background-color] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-[3px] hover:bg-mustard"
						href={l.href}
					>
						<span class="font-display text-[1.05rem] text-ink">{l.en}</span>
						<span class="text-[0.85rem] text-ink/75">{l.line}</span>
						<span class="mt-1 font-display text-[1.1rem] text-lacquer">{l.tel}</span>
					</a>
				))}
			</div>
		</section>

		<section class="panel riveted mt-10 bg-lacquer px-8 pb-8 pt-8 text-cream" aria-labelledby="claim-h">
			<h2 id="claim-h" class="text-[clamp(1.6rem,3vw,2.2rem)]">Claim a directory board</h2>
			<p class="mt-3">
				Shop, mill, PG or mess in Vasad? Your board hangs free on the {' '}
				<a class="text-mustard hover:text-cream" href="/directory">directory wall</a> — send the name, what you do, where, and a
				WhatsApp line, through the panchayat or the portal mail below. Boards carry the
				owner’s word, so the owner claims them.
			</p>
			<div class="mt-5">
				<a class="plate plate-ghost" href="mailto:jainilprajapati9@gmail.com">jainilprajapati9@gmail.com</a>
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<style>
	.row {
		display: grid;
		grid-template-columns: 9.5rem 1fr;
		gap: 0.8rem;
		padding: 0.7rem 0;
		border-bottom: 2px dashed color-mix(in srgb, var(--color-ink) 40%, transparent);
	}
	.row:last-child {
		border-bottom: 0;
	}
	dt {
		font-family: var(--font-display);
		font-size: 1.02rem;
	}
	dd {
		margin: 0;
		line-height: 1.5;
	}
</style>

---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const mills = [
	{ no: 'M1', en: 'Shree Mahi Dal Mill', line: 'Toor dal processing & grading', area: 'Mill compound, Vasad' },
	{ no: 'M2', en: 'Charotar Protein Foods', line: 'Dal milling & packing', area: 'NH 48 side' },
	{ no: 'M3', en: 'Navjivan Dal Industries', line: 'Cleaning, splitting & polishing', area: 'Station road' },
	{ no: 'M4', en: 'Gayatri Traders & Mill', line: 'Wholesale toor dal', area: 'Bazaar edge' },
	{ no: 'M5', en: 'Sardar Agro Mill', line: 'Toor & pulse processing', area: 'Vasad' },
];

const shops = [
	{ en: 'Vasad General Stores', gu: 'કિરાણા', line: 'Kirana & provisions', tone: 'lacquer', tilt: '-1.4deg' },
	{ en: 'Shree Krishna Sweet Mart', gu: 'ફરસાણ', line: 'Sweets & farsan', tone: 'green', tilt: '1.1deg' },
	{ en: 'Chaudhary Cycle Works', gu: 'સાયકલ', line: 'Cycles & repair', tone: 'mustard', tilt: '-0.6deg' },
	{ en: 'Telecom Care', gu: 'મોબાઈલ', line: 'Mobiles & repair', tone: 'green', tilt: '-1.1deg' },
	{ en: 'Mahalaxmi Hardware', gu: 'હાર્ડવેર', line: 'Paints, tools & pipes', tone: 'lacquer', tilt: '0.9deg' },
	{ en: 'Veni Pharmacy', gu: 'મેડિકલ', line: 'Medicines & chemist', tone: 'green', tilt: '0.7deg' },
	{ en: 'New Luck Tailors', gu: 'ટેલર', line: 'Stitching & uniforms', tone: 'mustard', tilt: '-0.9deg' },
	{ en: 'Mahi Chai & Nashta', gu: 'ચા', line: 'Tea & snacks', tone: 'lacquer', tilt: '1.3deg' },
];

const stays = [
	{ en: 'Shreeji Boys’ PG', type: 'PG · gents · mess included', area: 'Campus side' },
	{ en: 'Maa Umiya Girls’ PG', type: 'PG · ladies · homely mess', area: 'Vasad' },
	{ en: 'Annapurna Rooms', type: 'Rooms · daily & weekly', area: 'Station road' },
	{ en: 'Riverside Homestay', type: 'Guest rooms · families', area: 'Towards the Mahi' },
];
---

<Layout
	title="The Directory — Vasad | યાદી"
	description="Vasad's directory wall: toor dal mills, the bazaar's shops, and PG & room listings — sample boards awaiting their owners."
>
	<Nav />
	<main id="main" class="wrap">
		<header class="pagehead">
			<h1>The directory wall</h1>
			<p class="gu sub">યાદી — mills, shops and rooms, one board each</p>
			<p class="trust measure">
				Boards hang here the way they do in the bazaar: claimed by their owners, corrected by
				their owners. The boards below are <strong>worked samples</strong> standing where real
				listings go — nothing on them is an owner's word yet. To claim a board, add one, or
				correct one, write through the <a href="/contact">panchayat page</a>.
			</p>
		</header>

		<section class="yard" id="mills" aria-labelledby="mills-h">
			<h2 id="mills-h">The mill yard</h2>
			<p class="yardnote">
				The record counts <strong>45+ toor dal mills</strong> working in Vasad — the pulse trade
				of Charotar. Five sample waybills:
			</p>
			<ol class="ledger">
				{
					mills.map((m) => (
						<li class="way">
							<span class="no" aria-hidden="true">{m.no}</span>
							<span class="name">{m.en}</span>
							<span class="what">{m.line}</span>
							<span class="where">{m.area}</span>
							<span class="mark stamp">Sample · claim this board</span>
						</li>
					))
				}
			</ol>
			<p class="afternote">
				The other 40+ yards keep their books offline for now — their boards go up as owners
				claim them.
			</p>
		</section>

		<section class="yard" id="bazaar" aria-labelledby="bazaar-h">
			<h2 id="bazaar-h">The bazaar</h2>
			<p class="yardnote">Every shop paints its board its own colour. Eight samples:</p>
			<div class="wall">
				{
					shops.map((s) => (
						<a class:list={['board', `board--${s.tone}`]} href="/contact" style={`--tilt:${s.tilt}`}>
							<span class="b-en">{s.en}</span>
							<span class="b-gu gu">{s.gu}</span>
							<span class="b-line">{s.line}</span>
							<span class="b-mark stamp">Sample</span>
						</a>
					))
				}
			</div>
		</section>

		<section class="yard" id="staysec" aria-labelledby="stay-h">
			<h2 id="stay-h">Stay &amp; PG</h2>
			<p class="yardnote">
				Rooms for SVIT students, working visitors and families. Four sample plates:
			</p>
			<div class="staywall">
				{
					stays.map((s, i) => (
						<div class="stayplate" style={`--tilt:${i % 2 === 0 ? '-0.8deg' : '0.9deg'}`}>
							<span class="name">{s.en}</span>
							<span class="what">{s.type}</span>
							<span class="where">{s.area}</span>
							<span class="mark stamp">Sample · claim this board</span>
						</div>
					))
				}
			</div>
		</section>

		<section class="economy" aria-labelledby="eco-h">
			<div>
				<h2 id="eco-h">Why the wall is this long</h2>
				<p class="measure">
					Toor dal pays the town's bills — 45+ mills process the pulse that Charotar grows.
					Tobacco farming runs alongside, and the Soil &amp; Water Research Institute studies
					the ground it all stands on. The directory is the town's working economy, board by
					board.
				</p>
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<style>
	.pagehead {
		padding-top: 3rem;
	}
	h1 {
		font-size: clamp(2.3rem, 5vw, 3.4rem);
	}
	.sub {
		margin-top: 0.4rem;
		color: rgba(42, 39, 35, 0.8);
		font-size: 1.1rem;
	}
	.trust {
		margin-top: 1.1rem;
		background: var(--cream-hi);
		border: 3px solid var(--ink);
		border-radius: 12px;
		box-shadow: var(--paint-shadow);
		padding: 1.1rem 1.4rem;
	}
	h2 {
		font-size: clamp(1.8rem, 3.5vw, 2.5rem);
	}
	.yard {
		margin-top: 4.5rem;
	}
	.yardnote {
		margin-top: 0.5rem;
		color: rgba(42, 39, 35, 0.85);
	}

	.ledger {
		list-style: none;
		margin: 1.6rem 0 0;
		padding: 0;
		border-top: 3px solid var(--ink);
	}
	.way {
		display: grid;
		grid-template-columns: 3.4rem 1fr 1fr 7.5rem;
		grid-template-areas:
			'no name name mark'
			'no what where mark';
		column-gap: 1.1rem;
		align-items: center;
		padding: 0.95rem 0.4rem;
		border-bottom: 3px solid var(--ink);
		transition: background-color 0.25s ease-out, transform 0.25s ease-out;
	}
	.way:hover {
		background: var(--lacquer-wash);
		transform: translateX(6px);
	}
	.no {
		grid-area: no;
		font-family: var(--display);
		color: var(--cream);
		background: var(--lacquer);
		border: 2.5px solid var(--ink);
		border-radius: 7px;
		text-align: center;
		padding: 0.35rem 0;
	}
	.name {
		grid-area: name;
		font-family: var(--display);
		font-size: 1.3rem;
		line-height: 1.2;
	}
	.what {
		grid-area: what;
		color: rgba(42, 39, 35, 0.85);
	}
	.where {
		grid-area: where;
		font-weight: 600;
		color: rgba(42, 39, 35, 0.85);
	}
	.mark {
		grid-area: mark;
		justify-self: end;
	}
	@media (max-width: 820px) {
		.way {
			grid-template-columns: 3.4rem 1fr;
			grid-template-areas:
				'no name'
				'no what'
				'no where'
				'no mark';
			row-gap: 0.2rem;
		}
		.mark {
			justify-self: start;
		}
	}
	.afternote {
		margin-top: 1rem;
		color: rgba(42, 39, 35, 0.75);
		font-size: 0.95rem;
	}

	.wall {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
		gap: 1.6rem 1.4rem;
		margin-top: 2.2rem;
	}
	.board {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding: 1.3rem 1.3rem 1.2rem;
		border: 3px solid var(--ink);
		border-radius: 12px;
		text-decoration: none;
		box-shadow: var(--paint-shadow);
		transform: rotate(var(--tilt, 0deg));
		transform-origin: 50% -14px;
		transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.board::before {
		content: '';
		position: absolute;
		top: -14px;
		left: 50%;
		width: 3px;
		height: 14px;
		background: var(--ink);
	}
	.board:hover {
		transform: rotate(calc(var(--tilt, 0deg) * -0.5)) translateY(-4px);
	}
	.board--lacquer {
		background: var(--lacquer);
		color: var(--cream);
	}
	.board--green {
		background: var(--green);
		color: var(--cream);
	}
	.board--mustard {
		background: var(--mustard);
		color: var(--ink);
	}
	.b-en {
		font-family: var(--display);
		font-size: 1.3rem;
		line-height: 1.15;
	}
	.b-gu {
		font-size: 0.9rem;
		font-weight: 600;
		opacity: 0.9;
	}
	.b-line {
		margin-top: 0.35rem;
		font-size: 0.95rem;
	}
	.b-mark {
		margin-top: 0.7rem;
		align-self: flex-start;
	}
	.board--green .stamp,
	.board--lacquer .stamp {
		border-color: var(--cream);
		color: var(--cream);
	}
	.board--mustard .stamp {
		border-color: var(--ink);
		color: var(--ink);
	}

	.staywall {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: 1.8rem 1.6rem;
		margin-top: 2.2rem;
	}
	.stayplate {
		--tilt: 0deg;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		background: var(--cream-hi);
		border: 3px solid var(--ink);
		border-radius: 10px;
		box-shadow: var(--paint-shadow);
		padding: 1.3rem 1.3rem 1.2rem;
		transform: rotate(var(--tilt));
		transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.stayplate:hover {
		transform: rotate(0deg) translateY(-4px);
	}
	.stayplate .what {
		color: rgba(42, 39, 35, 0.85);
	}
	.stayplate .where {
		font-weight: 600;
		font-size: 0.95rem;
	}
	.stayplate .mark {
		margin-top: 0.6rem;
		align-self: flex-start;
	}

	.economy {
		margin-top: 5rem;
		background: var(--green);
		color: var(--cream);
		border: 3px solid var(--ink);
		border-radius: 12px;
		box-shadow: var(--paint-shadow);
		padding: 2.2rem 2.4rem;
	}
	.economy h2 {
		color: var(--mustard);
	}
	.economy p {
		margin-top: 0.8rem;
	}
</style>

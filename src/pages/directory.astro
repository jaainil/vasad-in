---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const dalMarts = [
	{
		en: 'Laxmi Toor Dal Flagship Store',
		gu: 'લક્ષ્મી તુવેર દાળ ફ્લેગશિપ સ્ટોર',
		where: 'NH-48 corridor, Vasad',
		near: 'Highway junction · 1.2 km from the station',
		line: 'The retail and bulk outlet of Vasad’s renowned Laxmi brand — sun-conditioned fataka dal, oiled dal and whole split pulses.',
		tags: ['Royal fataka', 'Castor-oiled', 'Export quality', 'Retail & wholesale', 'Pan-India courier'],
		tariff: '₹145 – ₹185 / kg · 1, 5 & 30 kg bags',
	},
	{
		en: 'Vasudhanagari Agro Dal Bhandar',
		gu: 'વસુધાનગરી એગ્રો દાળ ભંડાર',
		where: 'Station road, near Vasad Jn',
		near: '200 m from the railway station',
		line: 'Traditional unpolished desi toor dal straight from Charotar farms — no chemical polish, natural grain kept whole.',
		tags: ['Desi dal', '100% unpolished', 'Farm-direct', 'Family packs', 'Cash & UPI'],
		tariff: '₹135 – ₹170 / kg · loose & packed',
	},
	{
		en: 'Shree Mahisagar Pulse Mart',
		gu: 'શ્રી મહીસાગર પલ્સ માર્ટ',
		where: 'Main bazar road, near the old panchayat',
		near: 'Town centre · walk from the bazar',
		line: 'Famous for Charotari tel-wali dal — castor-oil tempered, Sortex-cleaned, keeping fresh up to twelve months.',
		tags: ['Tel-wali dal', 'Sortex cleaned', 'Annual stocking', 'Mandi rates', 'Home delivery'],
		tariff: '₹140 – ₹175 / kg · bulk rates for weddings',
	},
	{
		en: 'Charotar Pulse Processors Counter',
		gu: 'ચારોતર પલ્સ પ્રોસેસર્સ કાઉન્ટર',
		where: 'Borsad–Vasad state highway',
		near: 'Industrial belt · 800 m from the highway',
		line: 'High-volume mill counter with first-grade split peas at mill rates for caterers, retailers and annual household stocking.',
		tags: ['Commercial bulk', 'First-grade split', 'Grain cleaning', 'GST invoice'],
		tariff: '₹130 – ₹160 / kg · 30 & 50 kg bags',
	},
	{
		en: 'Patel Brothers Pulse Depot',
		gu: 'પટેલ બ્રધર્સ પલ્સ ડેપો',
		where: 'Mahadev mandir road, bluffs area',
		near: '300 m from the 200-year banyan',
		line: 'Family-run since 1974 — hand-sorted pigeon peas, roasted dal snacks and seasonal Charotar spices.',
		tags: ['Triple cleaned', 'Seasonal pulses', 'Snack dal', 'Local trust'],
		tariff: '₹140 – ₹180 / kg',
	},
];

const boysPg = [
	{
		en: 'Sardar Patel Student Residency',
		gu: 'સરદાર પટેલ છાત્ર નિવાસ',
		where: 'Station road, near SVIT Gate 1',
		near: '350 m from campus · 4-minute walk',
		line: 'Modern residency for engineering and architecture students — quiet study floors, mess, and 24-hour warden cover.',
		tags: ['2 & 3 sharing', 'Gujarati mess', 'High-speed WiFi', 'RO water', 'Solar hot water', 'Housekeeping'],
		tariff: '₹5,500 – ₹7,500 / month · 3 meals included',
	},
	{
		en: 'Charotar Scholar Living',
		gu: 'ચારોતર સ્કોલર લિવિંગ',
		where: 'Behind the SVIT workshop complex',
		near: '200 m walk to SVIT',
		line: 'Affordable clean twin-sharing with full-size desks for drafting and project work, optical fibre in every room.',
		tags: ['Twin sharing', 'Drafting desks', '100 Mbps fibre', 'Attached washrooms', 'Bike parking', 'Warden'],
		tariff: '₹4,800 – ₹6,200 / month · mess optional',
	},
	{
		en: 'Mahi Riverfront Youth Hostel',
		gu: 'મહી રિવરફ્રન્ટ યુથ હોસ્ટેલ',
		where: 'River bluffs road, near the ICAR campus',
		near: '700 m from SVIT · river view',
		line: 'Multi-storey student living on the bluff — balcony rooms, river breeze, badminton hall and hygienic mess.',
		tags: ['Balcony rooms', 'Sports area', 'Hygienic mess', 'CCTV', 'Study hall', 'Power backup'],
		tariff: '₹5,000 – ₹7,000 / month',
	},
];

const girlsPg = [
	{
		en: 'Mahi View Kanya Chhatralaya',
		gu: 'મહી વ્યુ કન્યા છાત્રાલય',
		where: 'Riverbank road, Vasad',
		near: '300 m from the SVIT girls-hostel gate',
		line: 'High-security residence for SVIT’s women students — biometric entry, resident lady rector, home-cooked meals.',
		tags: ['Biometric access', '24/7 CCTV', 'Lady rector', 'Home-cooked food', 'Laundry', 'First aid'],
		tariff: '₹6,000 – ₹8,000 / month · all inclusive',
	},
	{
		en: 'Radhe Krishna Girls Residency',
		gu: 'રાધે કૃષ્ણ ગર્લ્સ રેસિડેન્સી',
		where: 'Bazaar street, safe residential colony',
		near: '450 m from campus',
		line: 'Ventilated rooms with study furniture, parent-verified guest policy and quiet hours for exam season.',
		tags: ['Attached bathrooms', 'Gated society', 'Veg mess', 'Study desks', 'Solar geyser', 'RO water'],
		tariff: '₹5,500 – ₹7,200 / month',
	},
];

const mess = [
	{
		en: 'Annapurna Ghar Nu Tiffin',
		gu: 'અન્નપૂર્ણા ઘરનું ટિફિન સર્વિસ',
		where: 'Delivery across every PG and hostel',
		near: 'Doorstep to SVIT and all Vasad PGs',
		line: 'Pure-veg home cooking twice daily in hot insulated tiffins — phulka rotli, two sabzi, dal-bhat, weekend farsan.',
		tags: ['Hot tiffin delivery', 'Pure vegetarian', 'Meal pause', 'Sunday special', 'Monthly plan'],
		tariff: '₹2,600 – ₹3,200 / month · lunch + dinner',
	},
	{
		en: 'Charotar Dining Hall & Canteen',
		gu: 'ચારોતર ડાઇનિંગ હોલ',
		where: 'Station road, opposite SVIT Gate 1',
		near: '50 m from the campus gate',
		line: 'Air-cooled hall with unlimited Gujarati and Punjabi thali — monthly passes at student rates.',
		tags: ['Unlimited thali', 'Air cooled', 'Student pass', 'Hygiene inspected', 'Open 7 days'],
		tariff: '₹90 thali · ₹2,400 monthly pass',
	},
];

const required = [
	'Shop or PG name, with its Gujarati spelling',
	'Street address and the walk to SVIT, the highway or the station',
	'A direct mobile number, WhatsApp enabled',
	'Rates — dal tariffs, room sharing type, or thali pass',
];

const yards = [
	{ id: 'dal-marts', h: 'Toor dal retail &amp; mills', note: 'Five counters, direct mill rates on the plate:', chip: 'Dal counter', chipTone: 'bg-mustard text-ink', items: dalMarts },
	{ id: 'boys-pg', h: 'Boys’ PGs &amp; hostels', note: 'Walking distance from the SVIT gates:', chip: 'Boys’ PG', chipTone: 'bg-green text-cream', items: boysPg },
	{ id: 'girls-pg', h: 'Girls’ PGs &amp; hostels', note: 'Secured residences with resident rectors:', chip: 'Girls’ PG', chipTone: 'bg-lacquer text-cream', items: girlsPg },
	{ id: 'mess', h: 'Food mess &amp; tiffins', note: 'Hot plates for students and visitors:', chip: 'Mess &amp; tiffin', chipTone: 'bg-green text-cream', items: mess },
];
---

<Layout
	title="Vasad Directory — Dal, PGs & Local Trade | યાદી"
	description="Vasad's verified local registry: toor dal mills and retail counters, boys' and girls' PGs near SVIT, and tiffin services — direct owner listings with tariffs."
>
	<Nav />
	<main id="main" class="wrap">
		<header class="pt-12">
			<h1 class="text-[clamp(2.3rem,5vw,3.4rem)]">Vasad commerce &amp; student living</h1>
			<p class="font-gu mt-1.5 text-[1.1rem] text-ink/80">વસાદ વ્યાપાર, દાળ ભંડાર અને છાત્ર આવાસો</p>
			<p class="mt-4 max-w-[68ch] rounded-xl border-[3px] border-ink bg-cream-hi p-4 px-6 py-4 shadow-paint">
				The local index for buyers, students and parents: dal counters, PGs and messes, one
				board each, with tariffs on the plate. Twelve boards hang today. Call and WhatsApp
				lines publish with each owner’s claim — until then the {' '}
				<a href="/contact">panchayat desk</a> connects you. Regulated dal trade runs under the
				Anand APMC yard.
			</p>
			<nav class="mt-6 flex flex-wrap gap-3" aria-label="Directory sections">
				{
					yards.map((y) => (
						<a
							class="rounded-lg border-[2.5px] border-ink bg-cream-hi px-3.5 py-1.5 font-display text-[0.98rem] text-ink no-underline shadow-paint transition-[transform,background-color] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5 hover:-rotate-[0.6deg] hover:bg-mustard"
							href={`#${y.id}`}
							set:html={y.h}
						/>
					))
				}
			</nav>
		</header>

		{
			yards.map((yard, yi) => (
				<section class="mt-16" id={yard.id} aria-label={yard.note}>
					<h2 class="text-[clamp(1.8rem,3.5vw,2.5rem)]" set:html={yard.h} />
					<p class="mt-2 text-ink/85">{yard.note}</p>
					<div class="mt-8 grid grid-cols-[repeat(auto-fill,minmax(300px,1fr))] gap-x-6 gap-y-8">
						{yard.items.map((c, i) => (
							<article
								class:list={[
									'panel riveted flex flex-col gap-1 px-6 pt-6 pb-5 [transition:transform_0.55s_cubic-bezier(0.22,1,0.36,1)]',
									(yi + i) % 2 === 0 && '-rotate-[0.5deg] hover:rotate-0 hover:-translate-y-1',
									(yi + i) % 2 === 1 && 'rotate-[0.6deg] hover:rotate-0 hover:-translate-y-1',
								]}
							>
								<span
									class:list={[
										'inline-block w-fit -rotate-[1.2deg] rounded-lg border-[2.5px] border-ink px-2.5 py-0.5 font-gu text-[0.75rem] font-bold tracking-[0.05em] uppercase',
										yard.chipTone,
									]}
									aria-hidden="true"
									set:html={yard.chip}
								/>
								<h3 class="mt-2.5 text-[1.45rem]">{c.en}</h3>
								<p class="font-gu text-[0.95rem] font-semibold text-lacquer">{c.gu}</p>
								<p class="mt-2 text-[0.95rem] font-semibold">{c.where}</p>
								<p class="text-[0.85rem] font-semibold text-green">{c.near}</p>
								<p class="mt-2 text-[0.95rem] leading-[1.55] text-ink/90">{c.line}</p>
								<p class="mt-3 flex flex-wrap gap-1.5">
									{c.tags.map((t) => (
										<span class="rounded-md border-2 border-ink/55 px-2 py-0.5 text-[0.78rem] font-semibold text-ink/85">{t}</span>
									))}
								</p>
								<p class="mt-3.5 rounded-lg border-[2.5px] border-dashed border-ink bg-cream px-3 py-2 font-display text-[1.05rem]">
									<span class="mb-0.5 block font-gu text-[0.7rem] font-bold tracking-[0.08em] uppercase text-ink/65">Plate rate</span>
									{c.tariff}
								</p>
							</article>
						))}
					</div>
				</section>
			))
		}

		<section class="mt-20 border-y-[3px] border-ink bg-lacquer py-14 text-cream" id="getlisted" aria-label="Run a dal shop, PG or mess in Vasad?">
			<div class="wrap">
				<h2 class="text-[clamp(1.8rem,3.5vw,2.5rem)] text-mustard">Run a dal shop, PG or mess in Vasad?</h2>
				<p class="mt-4">
					This wall is read by highway travellers on NH 48, by students and parents arriving
					for SVIT admissions, and by grain buyers across Gujarat. Boards carry the owner’s
					word and the owner’s line — direct inquiries, zero brokerage.
				</p>
				<div class="mt-9 grid grid-cols-[repeat(auto-fit,minmax(230px,1fr))] gap-6">
					<div class="rounded-[10px] border-[2.5px] border-cream/50 px-5 py-4">
						<span class="block font-display text-[1.15rem] text-mustard">Direct inquiries</span>
						<span class="mt-0.5 block text-[0.92rem] text-cream/90">
							Calls and WhatsApp straight from buyers and students — no commissions.
						</span>
					</div>
					<div class="rounded-[10px] border-[2.5px] border-cream/50 px-5 py-4">
						<span class="block font-display text-[1.15rem] text-mustard">SVIT admission season</span>
						<span class="mt-0.5 block text-[0.92rem] text-cream/90">
							PGs and hostels get found when outstation students arrive.
						</span>
					</div>
					<div class="rounded-[10px] border-[2.5px] border-cream/50 px-5 py-4">
						<span class="block font-display text-[1.15rem] text-mustard">Search visibility</span>
						<span class="mt-0.5 block text-[0.92rem] text-cream/90">
							“Toor dal Vasad” and “PG near SVIT” searches land on your board.
						</span>
					</div>
				</div>
				<h3 class="mt-10 text-2xl">Send your details</h3>
				<ol class="mt-4 flex max-w-[60ch] flex-col gap-1.5 pl-6">
					{required.map((r) => <li>{r}</li>)}
				</ol>
				<div class="mt-6 flex flex-wrap gap-4">
					<a class="plate" href="https://wa.me/">Submit on WhatsApp</a>
					<a class="plate plate-ghost" href="mailto:jainilprajapati9@gmail.com">jainilprajapati9@gmail.com</a>
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>

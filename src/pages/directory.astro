---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const dalMarts = [
	{
		en: 'Laxmi Toor Dal Flagship Store',
		gu: 'લક્ષ્મી તુવેર દાળ ફ્લેગશિપ સ્ટોર',
		where: 'NH-48 corridor, Vasad',
		near: 'Highway junction · 1.2 km from the station',
		line: 'The retail and bulk outlet of Vasad’s renowned Laxmi brand — sun-conditioned fataka dal, oiled dal and whole split pulses.',
		tags: ['Royal fataka', 'Castor-oiled', 'Export quality', 'Retail & wholesale', 'Pan-India courier'],
		tariff: '₹145 – ₹185 / kg · 1, 5 & 30 kg bags',
	},
	{
		en: 'Vasudhanagari Agro Dal Bhandar',
		gu: 'વસુધાનગરી એગ્રો દાળ ભંડાર',
		where: 'Station road, near Vasad Jn',
		near: '200 m from the railway station',
		line: 'Traditional unpolished desi toor dal straight from Charotar farms — no chemical polish, natural grain kept whole.',
		tags: ['Desi dal', '100% unpolished', 'Farm-direct', 'Family packs', 'Cash & UPI'],
		tariff: '₹135 – ₹170 / kg · loose & packed',
	},
	{
		en: 'Shree Mahisagar Pulse Mart',
		gu: 'શ્રી મહીસાગર પલ્સ માર્ટ',
		where: 'Main bazar road, near the old panchayat',
		near: 'Town centre · walk from the bazar',
		line: 'Famous for Charotari tel-wali dal — castor-oil tempered, Sortex-cleaned, keeping fresh up to twelve months.',
		tags: ['Tel-wali dal', 'Sortex cleaned', 'Annual stocking', 'Mandi rates', 'Home delivery'],
		tariff: '₹140 – ₹175 / kg · bulk rates for weddings',
	},
	{
		en: 'Charotar Pulse Processors Counter',
		gu: 'ચારોતર પલ્સ પ્રોસેસર્સ કાઉન્ટર',
		where: 'Borsad–Vasad state highway',
		near: 'Industrial belt · 800 m from the highway',
		line: 'High-volume mill counter with first-grade split peas at mill rates for caterers, retailers and annual household stocking.',
		tags: ['Commercial bulk', 'First-grade split', 'Grain cleaning', 'GST invoice'],
		tariff: '₹130 – ₹160 / kg · 30 & 50 kg bags',
	},
	{
		en: 'Patel Brothers Pulse Depot',
		gu: 'પટેલ બ્રધર્સ પલ્સ ડેપો',
		where: 'Mahadev mandir road, bluffs area',
		near: '300 m from the 200-year banyan',
		line: 'Family-run since 1974 — hand-sorted pigeon peas, roasted dal snacks and seasonal Charotar spices.',
		tags: ['Triple cleaned', 'Seasonal pulses', 'Snack dal', 'Local trust'],
		tariff: '₹140 – ₹180 / kg',
	},
];

const boysPg = [
	{
		en: 'Sardar Patel Student Residency',
		gu: 'સરદાર પટેલ છાત્ર નિવાસ',
		where: 'Station road, near SVIT Gate 1',
		near: '350 m from campus · 4-minute walk',
		line: 'Modern residency for engineering and architecture students — quiet study floors, mess, and 24-hour warden cover.',
		tags: ['2 & 3 sharing', 'Gujarati mess', 'High-speed WiFi', 'RO water', 'Solar hot water', 'Housekeeping'],
		tariff: '₹5,500 – ₹7,500 / month · 3 meals included',
	},
	{
		en: 'Charotar Scholar Living',
		gu: 'ચારોતર સ્કોલર લિવિંગ',
		where: 'Behind the SVIT workshop complex',
		near: '200 m walk to SVIT',
		line: 'Affordable clean twin-sharing with full-size desks for drafting and project work, optical fibre in every room.',
		tags: ['Twin sharing', 'Drafting desks', '100 Mbps fibre', 'Attached washrooms', 'Bike parking', 'Warden'],
		tariff: '₹4,800 – ₹6,200 / month · mess optional',
	},
	{
		en: 'Mahi Riverfront Youth Hostel',
		gu: 'મહી રિવરફ્રન્ટ યુથ હોસ્ટેલ',
		where: 'River bluffs road, near the ICAR campus',
		near: '700 m from SVIT · river view',
		line: 'Multi-storey student living on the bluff — balcony rooms, river breeze, badminton hall and hygienic mess.',
		tags: ['Balcony rooms', 'Sports area', 'Hygienic mess', 'CCTV', 'Study hall', 'Power backup'],
		tariff: '₹5,000 – ₹7,000 / month',
	},
];

const girlsPg = [
	{
		en: 'Mahi View Kanya Chhatralaya',
		gu: 'મહી વ્યુ કન્યા છાત્રાલય',
		where: 'Riverbank road, Vasad',
		near: '300 m from the SVIT girls-hostel gate',
		line: 'High-security residence for SVIT’s women students — biometric entry, resident lady rector, home-cooked meals.',
		tags: ['Biometric access', '24/7 CCTV', 'Lady rector', 'Home-cooked food', 'Laundry', 'First aid'],
		tariff: '₹6,000 – ₹8,000 / month · all inclusive',
	},
	{
		en: 'Radhe Krishna Girls Residency',
		gu: 'રાધે કૃષ્ણ ગર્લ્સ રેસિડેન્સી',
		where: 'Bazaar street, safe residential colony',
		near: '450 m from campus',
		line: 'Ventilated rooms with study furniture, parent-verified guest policy and quiet hours for exam season.',
		tags: ['Attached bathrooms', 'Gated society', 'Veg mess', 'Study desks', 'Solar geyser', 'RO water'],
		tariff: '₹5,500 – ₹7,200 / month',
	},
];

const mess = [
	{
		en: 'Annapurna Ghar Nu Tiffin',
		gu: 'અન્નપૂર્ણા ઘરનું ટિફિન સર્વિસ',
		where: 'Delivery across every PG and hostel',
		near: 'Doorstep to SVIT and all Vasad PGs',
		line: 'Pure-veg home cooking twice daily in hot insulated tiffins — phulka rotli, two sabzi, dal-bhat, weekend farsan.',
		tags: ['Hot tiffin delivery', 'Pure vegetarian', 'Meal pause', 'Sunday special', 'Monthly plan'],
		tariff: '₹2,600 – ₹3,200 / month · lunch + dinner',
	},
	{
		en: 'Charotar Dining Hall & Canteen',
		gu: 'ચારોતર ડાઇનિંગ હોલ',
		where: 'Station road, opposite SVIT Gate 1',
		near: '50 m from the campus gate',
		line: 'Air-cooled hall with unlimited Gujarati and Punjabi thali — monthly passes at student rates.',
		tags: ['Unlimited thali', 'Air cooled', 'Student pass', 'Hygiene inspected', 'Open 7 days'],
		tariff: '₹90 thali · ₹2,400 monthly pass',
	},
];

const categories = [
	'Dal counter/mill',
	'Boys PG',
	'Girls PG',
	'Mess & tiffin',
	'Eatery',
	'Hotel/stay',
	'Shop/trade',
	'Clinic/hospital',
	'School/college',
	'Mandir',
	'Other',
];

const services = ['UPI', 'Home delivery', 'WiFi', 'AC', 'Mess included', 'Parking', '24x7'];

const yards = [
	{ id: 'dal-marts', h: 'Toor dal retail &amp; mills', note: 'Five counters, direct mill rates on the plate:', chip: 'Dal counter', chipTone: 'bg-mustard text-ink', items: dalMarts },
	{ id: 'boys-pg', h: 'Boys’ PGs &amp; hostels', note: 'Walking distance from the SVIT gates:', chip: 'Boys’ PG', chipTone: 'bg-green text-cream', items: boysPg },
	{ id: 'girls-pg', h: 'Girls’ PGs &amp; hostels', note: 'Secured residences with resident rectors:', chip: 'Girls’ PG', chipTone: 'bg-lacquer text-cream', items: girlsPg },
	{ id: 'mess', h: 'Food mess &amp; tiffins', note: 'Hot plates for students and visitors:', chip: 'Mess &amp; tiffin', chipTone: 'bg-green text-cream', items: mess },
];
---

<Layout
	title="Vasad Directory — Dal, PGs & Local Trade | યાદી"
	description="Vasad's verified local registry: toor dal mills and retail counters, boys' and girls' PGs near SVIT, and tiffin services — direct owner listings with tariffs."
>
	<Nav />
	<main id="main" class="wrap">
		<header class="pt-12">
			<h1 class="text-[clamp(2.3rem,5vw,3.4rem)]">Vasad commerce &amp; student living</h1>
			<p class="font-gu mt-1.5 text-[1.1rem] text-ink/80">વસાદ વ્યાપાર, દાળ ભંડાર અને છાત્ર આવાસો</p>
			<p class="mt-4 max-w-[68ch] rounded-xl border-[3px] border-ink bg-cream-hi p-4 px-6 py-4 shadow-paint">
				The local index for buyers, students and parents: dal counters, PGs and messes, one
				board each, with tariffs on the plate. Twelve boards hang today. Call and WhatsApp
				lines publish with each owner’s claim — until then the {' '}
				<a href="/contact">panchayat desk</a> connects you. Regulated dal trade runs under the
				Anand APMC yard.
			</p>
			<nav class="mt-6 flex flex-wrap gap-3" aria-label="Directory sections">
				{
					yards.map((y) => (
						<a
							class="rounded-lg border-[2.5px] border-ink bg-cream-hi px-3.5 py-1.5 font-display text-[0.98rem] text-ink no-underline shadow-paint transition-[transform,background-color] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5 hover:-rotate-[0.6deg] hover:bg-mustard"
							href={`#${y.id}`}
							set:html={y.h}
						/>
					))
				}
			</nav>
		</header>

		{
			yards.map((yard, yi) => (
				<section class="mt-16" id={yard.id} aria-label={yard.note}>
					<h2 class="text-[clamp(1.8rem,3.5vw,2.5rem)]" set:html={yard.h} />
					<p class="mt-2 text-ink/85">{yard.note}</p>
					<div class="mt-8 grid grid-cols-[repeat(auto-fill,minmax(300px,1fr))] gap-x-6 gap-y-8">
						{yard.items.map((c, i) => (
							<article
								class:list={[
									'panel riveted flex flex-col gap-1 px-6 pt-6 pb-5 [transition:transform_0.55s_cubic-bezier(0.22,1,0.36,1)]',
									(yi + i) % 2 === 0 && '-rotate-[0.5deg] hover:rotate-0 hover:-translate-y-1',
									(yi + i) % 2 === 1 && 'rotate-[0.6deg] hover:rotate-0 hover:-translate-y-1',
								]}
							>
								<span
									class:list={[
										'inline-block w-fit -rotate-[1.2deg] rounded-lg border-[2.5px] border-ink px-2.5 py-0.5 font-gu text-[0.75rem] font-bold tracking-[0.05em] uppercase',
										yard.chipTone,
									]}
									aria-hidden="true"
									set:html={yard.chip}
								/>
								<h3 class="mt-2.5 text-[1.45rem]">{c.en}</h3>
								<p class="font-gu text-[0.95rem] font-semibold text-lacquer">{c.gu}</p>
								<p class="mt-2 text-[0.95rem] font-semibold">{c.where}</p>
								<p class="text-[0.85rem] font-semibold text-green">{c.near}</p>
								<p class="mt-2 text-[0.95rem] leading-[1.55] text-ink/90">{c.line}</p>
								<p class="mt-3 flex flex-wrap gap-1.5">
									{c.tags.map((t) => (
										<span class="rounded-md border-2 border-ink/55 px-2 py-0.5 text-[0.78rem] font-semibold text-ink/85">{t}</span>
									))}
								</p>
								<p class="mt-3.5 rounded-lg border-[2.5px] border-dashed border-ink bg-cream px-3 py-2 font-display text-[1.05rem]">
									<span class="mb-0.5 block font-gu text-[0.7rem] font-bold tracking-[0.08em] uppercase text-ink/65">Plate rate</span>
									{c.tariff}
								</p>
							</article>
						))}
					</div>
				</section>
			))
		}

		<section class="mt-20 border-y-[3px] border-ink bg-lacquer py-14 text-cream" id="getlisted" aria-label="Run a dal shop, PG or mess in Vasad?">
			<div class="wrap">
				<h2 class="text-[clamp(1.8rem,3.5vw,2.5rem)] text-mustard">Run a dal shop, PG or mess in Vasad?</h2>
				<p class="mt-4">
					This wall is read by highway travellers on NH 48, by students and parents arriving
					for SVIT admissions, and by grain buyers across Gujarat. Boards carry the owner’s
					word and the owner’s line — direct inquiries, zero brokerage.
				</p>
				<div class="mt-9 grid grid-cols-[repeat(auto-fit,minmax(230px,1fr))] gap-6">
					<div class="rounded-[10px] border-[2.5px] border-cream/50 px-5 py-4">
						<span class="block font-display text-[1.15rem] text-mustard">Direct inquiries</span>
						<span class="mt-0.5 block text-[0.92rem] text-cream/90">
							Calls and WhatsApp straight from buyers and students — no commissions.
						</span>
					</div>
					<div class="rounded-[10px] border-[2.5px] border-cream/50 px-5 py-4">
						<span class="block font-display text-[1.15rem] text-mustard">SVIT admission season</span>
						<span class="mt-0.5 block text-[0.92rem] text-cream/90">
							PGs and hostels get found when outstation students arrive.
						</span>
					</div>
					<div class="rounded-[10px] border-[2.5px] border-cream/50 px-5 py-4">
						<span class="block font-display text-[1.15rem] text-mustard">Search visibility</span>
						<span class="mt-0.5 block text-[0.92rem] text-cream/90">
							“Toor dal Vasad” and “PG near SVIT” searches land on your board.
						</span>
					</div>
				</div>
			<div class="panel riveted mt-10 bg-cream-hi px-6 py-7 text-ink max-[560px]:px-4" id="add-form">
				<h3 class="text-[1.6rem]">Put your board on the wall</h3>
				<p class="font-gu mt-1 text-[0.95rem] font-semibold text-lacquer">
					નીચે વિગત ભરો — reviewed, then pinned on the map and the directory.
				</p>

				<form
					id="board-form"
					class="mt-6 flex flex-col gap-5"
					novalidate
					method="POST"
					target="_blank"
					action="https://docs.google.com/forms/d/e/1FAIpQLScWSyFPmeY0gKadpd94YzVfaGQQuN4EjzH-Ecn2prEpvABJ4Q/formResponse"
				>
					<input type="text" name="company" id="hp-company" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

					<div class="grid gap-5 md:grid-cols-2">
						<div class="flex flex-col gap-1.5">
							<label class="font-display text-[1.05rem]" for="f-name-en">Shop name (English) <span class="text-lacquer" aria-hidden="true">*</span></label>
							<input class="f-input" id="f-name-en" name="entry.487658782" type="text" required autocomplete="organization" placeholder="Laxmi Toor Dal Flagship Store" />
						</div>
						<div class="flex flex-col gap-1.5">
							<label class="font-display text-[1.05rem]" for="f-name-gu">ગુજરાતીમાં નામ <span class="text-lacquer" aria-hidden="true">*</span></label>
							<input class="f-input" id="f-name-gu" name="entry.159480209" type="text" required lang="gu" placeholder="લક્ષ્મી તુવેર દાળ" />
						</div>
					</div>

					<fieldset class="flex flex-col gap-2.5 border-0 p-0">
						<legend class="font-display text-[1.05rem]">Category <span class="text-lacquer" aria-hidden="true">*</span> <span class="font-body text-[0.85rem] text-ink/70">— pick one</span></legend>
						<div class="flex flex-wrap gap-2" id="category-chips">
							{
								categories.map((c) => (
									<label class="chip">
										<input type="checkbox" name="entry.1567350137" value={c} data-group="category" />
										<span>{c}</span>
									</label>
								))
							}
						</div>
					</fieldset>

					<div class="flex flex-col gap-1.5">
						<label class="font-display text-[1.05rem]" for="f-offer">What you offer <span class="text-lacquer" aria-hidden="true">*</span></label>
						<textarea class="f-input" id="f-offer" name="entry.1164576121" rows="3" required placeholder="Sun-conditioned fataka dal, oiled and unpolished — retail and bulk, courier across India."></textarea>
					</div>

					<fieldset class="flex flex-col gap-2.5 border-0 p-0">
						<legend class="font-display text-[1.05rem]">Services <span class="font-body text-[0.85rem] text-ink/70">— tick all that apply</span></legend>
						<div class="flex flex-wrap gap-2">
							{
								services.map((s) => (
									<label class="chip">
										<input type="checkbox" name="entry.69958718" value={s} />
										<span>{s}</span>
									</label>
								))
							}
						</div>
					</fieldset>

					<div class="grid gap-5 md:grid-cols-2">
						<div class="flex flex-col gap-1.5">
							<label class="font-display text-[1.05rem]" for="f-rates">Rates / plate price <span class="text-lacquer" aria-hidden="true">*</span></label>
							<input class="f-input" id="f-rates" name="entry.753515760" type="text" required placeholder="₹145 – ₹185 / kg · 1, 5 & 30 kg bags" />
						</div>
						<div class="flex flex-col gap-1.5">
							<label class="font-display text-[1.05rem]" for="f-street">Street / area <span class="text-lacquer" aria-hidden="true">*</span></label>
							<input class="f-input" id="f-street" name="entry.738917396" type="text" required placeholder="Station road, near Vasad Jn" />
						</div>
					</div>

					<div class="grid gap-5 md:grid-cols-2">
						<div class="flex flex-col gap-1.5">
							<label class="font-display text-[1.05rem]" for="f-landmark">Landmark &amp; walking distance <span class="font-body text-[0.85rem] text-ink/70">— optional</span></label>
							<input class="f-input" id="f-landmark" name="entry.1443771944" type="text" placeholder="200 m from the railway station" />
						</div>
						<div class="flex flex-col gap-1.5">
							<label class="font-display text-[1.05rem]" for="f-maps">Google Maps link <span class="text-lacquer" aria-hidden="true">*</span></label>
							<input class="f-input" id="f-maps" name="entry.1499072883" type="url" required placeholder="Share your shop on Google Maps → Copy link → paste here" />
							<span class="text-[0.85rem] text-ink/75">Paste the link — we read the exact pin from it. No coordinates to type.</span>
						</div>
					</div>

					<fieldset class="flex flex-col gap-2.5 border-0 p-0">
						<legend class="font-display text-[1.05rem]">Map status <span class="text-lacquer" aria-hidden="true">*</span></legend>
						<div class="grid gap-3 md:grid-cols-2">
							<label class="mapchoice">
								<input type="radio" name="entry.1034517891" value="Create map pin using link" checked />
								<span class="mapchoice-box" aria-hidden="true"></span>
								<span><strong class="font-display font-normal">Pin me on the map</strong><span class="block text-[0.9rem] text-ink/80">From the Google Maps link above.</span></span>
							</label>
							<label class="mapchoice">
								<input type="radio" name="entry.1034517891" value="Directory only (no map pin)" />
								<span class="mapchoice-box" aria-hidden="true"></span>
								<span><strong class="font-display font-normal">Directory only</strong><span class="block text-[0.9rem] text-ink/80">No map pin — we still keep your Maps link on record.</span></span>
							</label>
						</div>
					</fieldset>

					<div class="grid gap-5 md:grid-cols-2">
						<div class="flex flex-col gap-1.5">
							<label class="font-display text-[1.05rem]" for="f-owner">Owner / contact person <span class="text-lacquer" aria-hidden="true">*</span></label>
							<input class="f-input" id="f-owner" name="entry.2007134093" type="text" required autocomplete="name" />
						</div>
						<div class="flex flex-col gap-1.5">
							<label class="font-display text-[1.05rem]" for="f-mobile">Mobile number <span class="text-lacquer" aria-hidden="true">*</span></label>
							<input class="f-input" id="f-mobile" name="entry.299352551" type="tel" required inputmode="numeric" autocomplete="tel" placeholder="98XXXXXXXX" />
							<span class="text-[0.85rem] text-ink/75">Shown on your board — buyers call you directly.</span>
						</div>
					</div>

					<fieldset class="flex flex-col gap-2.5 border-0 p-0">
						<legend class="font-display text-[1.05rem]">Is this your WhatsApp number? <span class="text-lacquer" aria-hidden="true">*</span></legend>
						<div class="grid gap-3 md:grid-cols-2">
							<label class="mapchoice">
								<input type="radio" name="entry.1855344288" value="Yes" checked />
								<span class="mapchoice-box" aria-hidden="true"></span>
								<span><strong class="font-display font-normal">Yes</strong></span>
							</label>
							<label class="mapchoice">
								<input type="radio" name="entry.1855344288" value="No, I will provide a separate WhatsApp number" />
								<span class="mapchoice-box" aria-hidden="true"></span>
								<span><strong class="font-display font-normal">No</strong><span class="block text-[0.9rem] text-ink/80">We'll call and take the other number.</span></span>
							</label>
						</div>
					</fieldset>

					<label class="flex cursor-pointer items-start gap-2.5 rounded-lg border-[2.5px] border-dashed border-ink bg-cream px-4 py-3">
						<input type="checkbox" id="f-declare" name="entry.628294987" value="This is my shop or I am authorised to list this. I understand my number may be shown on the public board." required class="mt-1 h-4 w-4 shrink-0 accent-lacquer" />
						<span class="text-[0.95rem] leading-[1.5]">
							<strong class="font-display font-normal">Declaration —</strong> this is my shop, or I am authorised to list it. I understand my number may be shown on the public board. <span class="text-lacquer" aria-hidden="true">*</span>
						</span>
					</label>

					<div class="flex flex-wrap items-center gap-4">
						<button type="submit" class="plate cursor-pointer border-[3px] border-ink font-display text-[1.15rem]">Submit — pin my board</button>
						<p class="m-0 text-[0.9rem] text-ink/75">Boards go up after a quick check — usually within a day or two.</p>
					</div>
					<p class="f-status m-0 hidden rounded-lg border-[2.5px] border-ink bg-cream px-4 py-3" role="alert"></p>
				</form>

				<div id="board-done" class="hidden" tabindex="-1">
					<p class="font-gu text-[1.15rem] font-bold text-green">બોર્ડ મળી ગયો!</p>
					<p class="mt-2 max-w-[60ch]">
						Board received. We check every listing by hand, then hang it on the directory and
						pin it on the map — usually within a day or two.
					</p>
					<p class="mt-3 text-[0.95rem] text-ink/80">
						Want to add a photo or edit details later? Write to the {' '}
						<a href="/contact">panchayat desk</a>.
					</p>
				</div>
			</div>
		</div>
	</section>
</main>
<Footer />
</Layout>

<style>
	.f-input {
		width: 100%;
		border: 2.5px solid var(--color-ink);
		border-radius: 10px;
		background: var(--color-cream);
		padding: 0.55rem 0.8rem;
		font: inherit;
		color: inherit;
	}
	.f-input::placeholder { color: rgb(42 39 35 / 0.45); }
	.f-input[aria-invalid='true'] { border-color: var(--color-lacquer); background: #f3ddda; }

	.chip { position: relative; cursor: pointer; }
	.chip input { position: absolute; opacity: 0; pointer-events: none; }
	.chip span {
		display: inline-block;
		border: 2.5px solid var(--color-ink);
		border-radius: 999px;
		background: var(--color-cream);
		padding: 0.32rem 0.85rem;
		font-size: 0.9rem;
		font-weight: 600;
		transition: background-color 0.2s ease-out, transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.chip:hover span { background: var(--color-mustard); transform: translateY(-1px); }
	.chip input:checked + span { background: var(--color-ink); color: var(--color-cream); }
	.chip input:focus-visible + span { outline: 3px solid var(--color-mustard); outline-offset: 3px; }

	.mapchoice {
		position: relative;
		display: flex;
		align-items: flex-start;
		gap: 0.6rem;
		cursor: pointer;
		border: 2.5px solid var(--color-ink);
		border-radius: 10px;
		background: var(--color-cream);
		padding: 0.7rem 0.9rem;
	}
	.mapchoice input { position: absolute; opacity: 0; }
	.mapchoice-box {
		width: 18px;
		height: 18px;
		flex-shrink: 0;
		margin-top: 0.2rem;
		border: 2.5px solid var(--color-ink);
		border-radius: 50%;
		background: var(--color-cream-hi);
	}
	.mapchoice:has(input:checked) { background: var(--color-cream-hi); }
	.mapchoice input:checked ~ .mapchoice-box { background: var(--color-lacquer); box-shadow: inset 0 0 0 3px var(--color-cream); }
	.mapchoice:has(input:focus-visible) { outline: 3px solid var(--color-mustard); outline-offset: 3px; }
</style>

<script>
	const FORM_STATUS = {
		required: 'A few boards are still blank on the form — fill the marked fields and submit again.',
		mobile: 'That mobile number does not look right — ten digits, starting 6–9.',
		link: 'Paste your Google Maps link, or choose “Directory only” for the map status.',
		category: 'Pick one category chip for your board.',
		declare: 'Tick the declaration — boards hang only with the owner’s word.',
		failed:
			'The submit did not go through. Try again, or open the form directly: https://docs.google.com/forms/d/e/1FAIpQLScWSyFPmeY0gKadpd94YzVfaGQQuN4EjzH-Ecn2prEpvABJ4Q/viewform',
	};

	const form = document.getElementById('board-form') as HTMLFormElement | null;
	const done = document.getElementById('board-done');
	const statusEl = document.querySelector<HTMLElement>('.f-status');

	if (form) {
		const q = (sel: string) => form.querySelector<HTMLInputElement>(sel);
		const qa = (sel: string) => Array.from(form.querySelectorAll<HTMLInputElement>(sel));

		/* Category reads as a single pick, even though the Google question allows many. */
		qa('input[data-group]').forEach((chip) => {
			chip.addEventListener('change', () => {
				if (!chip.checked) return;
				qa(`input[data-group="${chip.dataset.group}"]`).forEach((o) => {
					if (o !== chip) o.checked = false;
				});
			});
		});

		/* The Google form keeps the Maps link required server-side — mirror that here. */
		const mapsInput = q('input[name="entry.1499072883"]');
		if (mapsInput) mapsInput.required = true;

		const mark = (el: HTMLInputElement, bad: boolean) => {
			if (bad) el.setAttribute('aria-invalid', 'true');
			else el.removeAttribute('aria-invalid');
		};

		const showStatus = (msg: string, withLink = false) => {
			if (!statusEl) return;
			statusEl.classList.remove('hidden');
			statusEl.textContent = '';
			statusEl.append(msg);
			if (withLink) {
				statusEl.append(' ');
				const a = document.createElement('a');
				a.href = FORM_STATUS.failed.split('directly: ')[1];
				a.textContent = 'Open the form directly';
				a.target = '_blank';
				a.rel = 'noopener';
				statusEl.append(a);
			}
		};

		form.addEventListener('submit', async (ev) => {
			if (!statusEl) return;
			statusEl.classList.add('hidden');

			/* Honeypot: bots fill everything — humans never see this field. */
			const hp = q('#hp-company');
			if (hp && hp.value.trim() !== '') {
				form.classList.add('hidden');
				if (done) {
					done.classList.remove('hidden');
					done.focus();
				}
				ev.preventDefault();
				return;
			}

			const bad: string[] = [];
			const fields = ['487658782', '159480209', '1164576121', '753515760', '738917396', '2007134093', '299352551'];
			let firstBad: HTMLInputElement | null = null;
			for (const id of fields) {
				const el = q(`input[name="entry.${id}"], textarea[name="entry.${id}"]`);
				if (!el) continue;
				const empty = el.value.trim() === '';
				mark(el, empty);
				if (empty) {
					bad.push(FORM_STATUS.required);
					firstBad ??= el;
				}
			}

			const category = qa('input[name="entry.1567350137"]:checked');
			if (category.length === 0) bad.push(FORM_STATUS.category);

			const rawMobile = (q('input[name="entry.299352551"]')?.value ?? '').replace(/\D/g, '');
			const mobile = rawMobile.replace(/^91(?=\d{10}$)/, '').replace(/^0(?=\d{10}$)/, '');
			if (!/^[6-9]\d{9}$/.test(mobile)) bad.push(FORM_STATUS.mobile);

			const mapsEl = q('input[name="entry.1499072883"]');
			const mapsOk = /^https?:\/\//.test((mapsEl?.value ?? '').trim());
			mark(mapsEl as HTMLInputElement, !mapsOk);
			if (!mapsOk) bad.push(FORM_STATUS.link);

			const declared = q('input[name="entry.628294987"]:checked');
			if (!declared) bad.push(FORM_STATUS.declare);

			ev.preventDefault();
			if (bad.length > 0) {
				showStatus(bad[0]);
				firstBad?.focus();
				return;
			}

			/* Normalise the mobile into the sheet. */
			const mobileEl = q('input[name="entry.299352551"]');
			if (mobileEl) mobileEl.value = mobile;

			try {
				const payload = new URLSearchParams();
				for (const [k, v] of new FormData(form).entries()) {
					if (typeof v === 'string' && v.trim() !== '') payload.append(k, v);
				}
				payload.append('fvv', '1');
				payload.append('pageHistory', '0');
				await fetch(form.action, { method: 'POST', mode: 'no-cors', body: payload });
				form.classList.add('hidden');
				if (done) {
					done.classList.remove('hidden');
					done.focus();
				}
			} catch {
				showStatus(FORM_STATUS.failed, true);
			}
		});
	}
</script>

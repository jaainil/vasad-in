---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const colleges = [
	{
		badge: 'B.Tech · M.Tech',
		en: 'College of Engineering',
		gu: 'એન્જિનિયરિંગ કોલેજ',
		line: 'Computer, Civil, Mechanical, Electrical, IT, and Electronics & Communication.',
		body: 'Gujarat Technological University',
		intake: '840+ seats a year',
	},
	{
		badge: 'B.Arch · M.Arch',
		en: 'College of Architecture',
		gu: 'આર્કિટેક્ચર કોલેજ',
		line: 'Urban design, sustainable habitat planning, landscape architecture.',
		body: 'Council of Architecture & GTU',
		intake: '80 seats a year',
	},
	{
		badge: 'B.Sc · GNM · MCA',
		en: 'Nursing & Computer Applications',
		gu: 'નર્સિંગ અને એમ.સી.એ.',
		line: 'Clinical healthcare and advanced software systems.',
		body: 'Gujarat Nursing Council & GTU',
		intake: '240+ seats a year',
	},
];

const campusStats = [
	{ big: '4,000+', line: 'students on campus' },
	{ big: '18,000+', line: 'alumni worldwide' },
	{ big: '28+', line: 'research laboratories' },
	{ big: 'Since 1997', line: 'affiliated to GTU' },
];

const pillars = [
	{ no: 'I', en: 'Gully control & check dams', line: 'Masonry drop spillways and vegetative dams slow cloudburst runoff by most of its pace, dropping silt instead of washing soil.' },
	{ no: 'II', en: 'Agroforestry & bamboo', line: 'Dendrocalamus bamboo and neem plantations bind the ravine crests permanently — K. G. Tejwani’s founding research here.' },
	{ no: 'III', en: 'Water harvesting', line: 'Watershed models send monsoon water back into the ground, holding the water table and pushing salinity back from the fields.' },
];
---

<Layout
	title="Study — Vasad | અભ્યાસ"
	description="Education in Vasad: SVIT's three colleges — engineering, architecture, nursing & MCA — the ICAR soil & water research station, and the town's 80.12% literacy."
>
	<Nav />
	<main id="main" class="wrap">
		<header class="pt-12">
			<h1 class="text-[clamp(2.3rem,5vw,3.4rem)]">The campus &amp; the classroom</h1>
			<p class="gu mt-1.5 text-[1.1rem] text-ink/80">અભ્યાસ — a market town that sends its children to college</p>
		</header>

		<section class="panel riveted mt-10 bg-cream-hi px-8 pb-8 pt-8" aria-labelledby="svit-h">
			<div class="flex flex-wrap items-baseline justify-between gap-4">
				<h2 id="svit-h" class="max-w-[22ch] text-[clamp(1.6rem,3.2vw,2.4rem)]">
					SVIT — Sardar Vallabhbhai Patel Institute of Technology
				</h2>
				<span class="inline-block rotate-[1.5deg] rounded-lg border-[3px] border-ink bg-mustard px-3 py-1 font-display text-[0.95rem] text-ink">
					Since 1997
				</span>
			</div>
			<p class="measure mt-3.5">
				The riverbank campus changed what this town is. Affiliated to the
				<strong>Gujarat Technological University</strong>, SVIT runs three colleges whose
				graduates now lead works from Gujarat to Silicon Valley:
			</p>
			<div class="mt-7 grid grid-cols-[repeat(auto-fit,minmax(250px,1fr))] gap-6">
				{colleges.map((c) => (
					<div class="flex flex-col gap-1 rounded-xl border-[3px] border-ink bg-cream px-6 py-5 shadow-paint">
						<span class="inline-block w-fit -rotate-[1.2deg] rounded-lg border-[3px] border-ink bg-mustard px-3 py-1 font-display text-[0.95rem] text-ink">
							{c.badge}
						</span>
						<span class="mt-1.5 font-display text-[1.35rem]">{c.en}</span>
						<span class="gu text-[0.9rem] font-semibold text-lacquer">{c.gu}</span>
						<span class="mt-1 text-[0.93rem] text-ink/85">{c.line}</span>
						<span class="mt-2 text-[0.9rem] font-semibold">{c.body}</span>
						<span class="font-display text-[0.95rem] text-green">{c.intake}</span>
					</div>
				))}
			</div>
			<div class="mt-7 grid grid-cols-[repeat(auto-fit,minmax(160px,1fr))] gap-5">
				{campusStats.map((s) => (
					<div class="flex flex-col rounded-[10px] border-[2.5px] border-ink bg-cream px-4 py-3.5">
						<span class="font-display text-[1.6rem] text-lacquer">{s.big}</span>
						<span class="text-[0.85rem] text-ink/80">{s.line}</span>
					</div>
				))}
			</div>
			<blockquote class="mt-9 rounded-xl border-[3px] border-ink bg-cream px-7 py-6 shadow-paint">
				<p class="font-display text-xl leading-[1.45]">
					“Educating minds where the historic waters of the Mahi meet the pioneering
					entrepreneurial spirit of Charotar.”
				</p>
				<cite class="mt-2.5 block text-[0.88rem] not-italic text-ink/70">SVIT institutional creed · Vasad, Anand</cite>
			</blockquote>
			<p class="mt-6 text-ink/85">
				Students from across Gujarat study here — the town keeps a PG and rooms wall on the {' '}
				<a href="/directory#boys-pg">directory</a>.
			</p>
		</section>

		<section class="panel riveted mt-10 bg-green px-8 pb-8 pt-8 text-cream" id="research" aria-labelledby="inst-h">
			<h2 class="text-[clamp(1.6rem,3vw,2.2rem)]">The ground, studied here</h2>
			<p class="gu mt-0.5 text-[0.95rem] font-semibold text-cream/80">કેન્દ્રીય જમીન સંરક્ષણ અને જળ સંશોધન કેન્દ્ર — વાસદ</p>
			<p class="mt-3 max-w-[68ch]">
				The <strong>ICAR–Indian Institute of Soil and Water Conservation’s</strong> research
				station works from Vasad on the Mahi’s ravines — the kotar terraces — turning eroding
				gullies into held, farmable ground. Three pillars carry the work:
			</p>
			<div class="mt-7 grid grid-cols-[repeat(auto-fit,minmax(230px,1fr))] gap-6">
				{pillars.map((p) => (
					<div class="relative rounded-xl border-[3px] border-ink bg-cream py-5 pl-14 pr-5 pb-4 text-ink shadow-paint">
						<span class="absolute top-4 left-4 font-display text-[1.4rem] text-lacquer" aria-hidden="true">{p.no}</span>
						<span class="block font-display text-[1.12rem]">{p.en}</span>
						<span class="mt-0.5 block text-[0.9rem] text-ink/85">{p.line}</span>
					</div>
				))}
			</div>
		</section>

		<section class="panel riveted mt-10 bg-lacquer px-8 pb-8 pt-8 text-cream" aria-labelledby="lit-h">
			<h2 class="text-[clamp(1.6rem,3vw,2.2rem)]">The record on the wall</h2>
			<p class="mt-2 font-display text-[clamp(2.6rem,6vw,4rem)] text-mustard">80.12%</p>
			<p class="mt-2 max-w-[50ch]">
				The town’s literacy at the 2011 Census — men at 84.18%, women at 75.66% — across
				3,047 households.
			</p>
		</section>
	</main>
	<Footer />
</Layout>

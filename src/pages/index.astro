---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import LorryFlank from '../components/LorryFlank.astro';

const lots = [
	{ no: '1', en: 'The Mahi Riverside', gu: 'મહી નદી', line: 'The northern bank, the ravine bluffs, the railway viaducts.', href: '#mahi' },
	{ no: '2', en: 'The Toor Dal Mills', gu: 'દાણાના ભોઠા', line: '45+ pulse mills — the dal capital of Gujarat.', href: '#dal' },
	{ no: '3', en: 'The SVIT Campus', gu: 'એસ.વી.આઈ.ટી.', line: 'Engineering, architecture, nursing — on the riverbank since 1997.', href: '#campus' },
	{ no: '4', en: 'Soil & Water Science', gu: 'જમીન સંરક્ષણ', line: 'The ICAR research station that reclaimed the ravines.', href: '#soil' },
	{ no: '5', en: 'Ashram, Banyan & Junction', gu: 'આશ્રમ · વડ · સ્ટેશન', line: 'The sacred circuit and the Western Railway node.', href: '#landmarks' },
	{ no: '6', en: 'The Panchayat Desk', gu: 'પંચાયત', line: 'Civic services, registers and emergency lines.', href: '#panchayat' },
];

const dalStats = [
	{ big: '45+', line: 'processing mills in the Vasad cluster' },
	{ big: '1,200+ MT', line: 'daily pulse capacity across the yards' },
	{ big: '18 states + NRI', line: 'reach of Vasad dal, packed in Charotar' },
];

const method = [
	{ no: '01', en: 'Sun conditioning', line: 'Open-air solar drying on floor yards in the dry Charotar breeze.' },
	{ no: '02', en: 'Water tempering', line: 'Controlled moisture loosens the husk without cooking the kernel.' },
	{ no: '03', en: 'Emery dehusking', line: 'Low-friction stone mills split the pea with zero fracture loss.' },
	{ no: '04', en: 'Traditional coating', line: 'A castor-oil film locks in sweetness for twelve-month shelves.' },
];

const registry = [
	{ en: 'Laxmi Toor Dal Processing Works', gu: 'લક્ષ્મી તુવેર દાળ', estd: '1968', cap: '120 MT/day', line: 'Export-grade oiled & unpolished dal', mark: 'Flagship Vasad brand' },
	{ en: 'Delawala Grain & Pulse Mills', gu: 'ડેલાવાળા ગ્રેઇન એન્ડ પલ્સ', estd: '1964', cap: '55 MT/day', line: 'Hand-sorted Charotar toor dal', mark: 'Heritage pioneer' },
	{ en: 'Vasad Agro Industries', gu: 'વસાદ એગ્રો ઇન્ડસ્ટ્રીઝ', estd: '1978', cap: '80 MT/day', line: 'Golden sweet split pigeon peas', mark: 'High-volume producer' },
	{ en: 'Charotar Pulse Processors Co.', gu: 'ચારોતર પલ્સ પ્રોસેસર્સ', estd: '1983', cap: '65 MT/day', line: 'Castor-oiled dal — તેલવાળી તુવેર દાળ', mark: 'Export standard' },
	{ en: 'Shree Mahisagar Agro Mills', gu: 'શ્રી મહીસાગર એગ્રો મિલ્સ', estd: '1992', cap: '45 MT/day', line: 'Unpolished organic desi toor dal', mark: '100% unpolished' },
	{ en: 'Patel Brothers Pulse Corporation', gu: 'પટેલ બ્રધર્સ પલ્સ', estd: '1988', cap: '75 MT/day', line: 'Triple-cleaned bold-grain split dal', mark: 'Pan-India distributor' },
];

const strata = [
	{ depth: '0.0 – 0.6 m', en: 'Charotar goradu loam', line: 'Nutrient-rich sandy loam — the taproot bed of dal and tobacco.' },
	{ depth: '0.6 – 3.5 m', en: 'Calcareous silt & kankar', line: 'Dense subsoil that gullies fast once cover is stripped.' },
	{ depth: '3.5 – 12 m', en: 'Kotar ravine terraces', line: 'Held by contour bunding, check dams and root nets.' },
	{ depth: '12 m +', en: 'Mahi fluvial sands', line: 'The recharge zone feeding wells and borewells.' },
];

const pillars = [
	{ no: 'I', en: 'Gully control & check dams', line: 'Masonry drop spillways and vegetative dams slow cloudburst runoff, dropping silt instead of soil.' },
	{ no: 'II', en: 'Agroforestry & bamboo', line: 'Dendocalamus bamboo and neem bind the ravine crests — K. G. Tejwani’s founding work here.' },
	{ no: 'III', en: 'Water harvesting', line: 'Watershed models recharge rainwater back into the ground, holding salinity at bay.' },
];

const colleges = [
	{ badge: 'B.Tech · M.Tech', en: 'College of Engineering', gu: 'એન્જિનિયરિંગ કોલેજ', line: 'Computer, Civil, Mechanical, Electrical, IT and Electronics & Communication.', body: 'Gujarat Technological University', intake: '840+ seats a year' },
	{ badge: 'B.Arch · M.Arch', en: 'College of Architecture', gu: 'આર્કિટેક્ચર કોલેજ', line: 'Urban design, sustainable habitat and landscape architecture.', body: 'Council of Architecture & GTU', intake: '80 seats a year' },
	{ badge: 'B.Sc · GNM · MCA', en: 'Nursing & Computer Applications', gu: 'નર્સિંગ અને એમ.સી.એ.', line: 'Clinical healthcare and advanced software systems.', body: 'Gujarat Nursing Council & GTU', intake: '240+ seats a year' },
];

const campusStats = [
	{ big: '4,000+', line: 'students on campus' },
	{ big: '18,000+', line: 'alumni worldwide' },
	{ big: '28+', line: 'research laboratories' },
	{ big: 'Since 1997', line: 'affiliated to GTU' },
];

const landmarks = [
	{ en: 'Art of Living Gujarat Ashram', gu: 'આર્ટ ઓફ લિવિંગ આશ્રમ', line: 'Residential Sudarshan Kriya retreats, silent sits and youth courses in greenery over the northern bank.', tone: 'lacquer' },
	{ en: 'The 200-Year Banyan', gu: 'ઇતિહાસિક વડ વૃક્ષ', line: 'Two centuries of prop roots beside the Mahadev mandir — the town’s living guardian.', tone: 'green' },
	{ en: 'Krishna Riverside Resort', gu: 'કૃષ્ણા રિવરસાઇડ રિસોર્ટ', line: 'River-cliff nature trails, open lawns, water adventure and Charotar Kathiyawadi dining.', tone: 'mustard' },
	{ en: 'Vasad Junction (VDA)', gu: 'વાસદ જંકશન', line: 'Western Railway node on the Mumbai–Ahmedabad trunk — passengers, MEMU and express over the viaduct.', tone: 'green' },
];

const mandirs = [
	{ en: 'Mahadev Mandir', gu: 'મહાદેવ', line: 'Riverside shivalaya beside the old banyan.' },
	{ en: 'Veharai Mata Mandir', gu: 'વેહરાઈ માતા', line: 'Kuldevi shrine of Charotar households.' },
	{ en: 'Jalaram Mandir', gu: 'જલારામ બાપા', line: 'Daily sadavrat and prayer gatherings.' },
	{ en: 'Swaminarayan Mandir', gu: 'સ્વામિનારાયણ', line: 'Shikharbaddh sanctum, youth assemblies.' },
	{ en: 'Sat Kaival Mandir', gu: 'સત કૈવલ', line: 'Kaival gyan philosophy and hymns.' },
	{ en: 'Ram Mandir', gu: 'રામ મંદિર', line: 'Ram Navami processions from the village heart.' },
];

const daytrips = [
	{ en: 'Vadodara', km: '20 km', line: 'Laxmi Vilas Palace, Kirti Mandir, Sayaji Baug', time: '25 min down NH 48' },
	{ en: 'Dakor', km: '35 km', line: 'Ranchhodraiji Mandir and the Gomti lake', time: '40 min via Anand–Umreth' },
	{ en: 'Champaner-Pavagadh', km: '65 km', line: 'UNESCO World Heritage and Kalika Mata', time: '1 hr 15 via Halol' },
	{ en: 'Statue of Unity', km: '105 km', line: 'The 182 m colossus and Sardar Sarovar', time: '2 hrs via Vadodara–Dabhoi' },
];

const ethos = [
	{ en: 'Dialect & script', line: 'Proud Charotari Gujarati, with literary and mercantile roots.' },
	{ en: 'Community', line: 'Patidars, artisans, traders and scholars across 3,047 households.' },
	{ en: 'Hospitality', line: 'Charotar warmth for travellers on the old trunk highway.' },
	{ en: 'Rhythm', line: 'Fields at morning, mills by day, the Mahi’s bank at dusk.' },
];

const civicRows = [
	['Sarpanch', 'Poonambhai D. Parmar'],
	['Deputy Sarpanch', 'Deepbhai P. Patel'],
	['Constituencies', 'Anklav Vidhan Sabha · Anand Lok Sabha'],
	['Post & dialling', 'PIN 388306 · STD 02692'],
];

const civicStats = [
	{ big: '14,384', line: 'residents' },
	{ big: '3,047', line: 'households' },
	{ big: '910', line: 'women per 1,000 men' },
	{ big: '80.12%', line: 'literacy' },
];

const services = [
	{ en: 'Drinking water & borewell supply', line: 'Filtered groundwater to every ward from overhead tanks.', when: 'Water: 6:00–8:30 am · 5:30–7:30 pm' },
	{ en: 'Sanitation & Swachh Bharat cell', line: 'Door-to-door collection and segregated composting.', when: 'Daily 7:00 am – 2:00 pm' },
	{ en: 'Birth, death & marriage registry', line: 'Computer-generated civil certificates on the spot.', when: 'Mon–Sat 10:30 am – 5:30 pm' },
	{ en: 'Land records & e-Gram desk', line: '7/12 and 8A records, subsidy help for dal and banana growers.', when: 'Mon–Sat 11:00 am – 4:00 pm' },
];

const emergency = [
	{ en: 'Gram Panchayat Bhavan', line: 'Civic office', tel: '02692 274220' },
	{ en: 'Primary Health Centre', line: 'Emergency health · 108', tel: '02692 274102' },
	{ en: 'Vasad Police Station', line: 'Law & order · 100', tel: '02692 274333' },
	{ en: 'MGVCL Power Substation', line: 'Electricity · 19122', tel: '02692 274411' },
	{ en: 'Vasad Jn. Railway help', line: 'Rail transit · 139', tel: 'WR helpdesk' },
];
---

<Layout
	title="Vasad — Gateway to Charotar | વાસદ"
	description="Vasad (Vasudhanagari), Anand district, Gujarat: the Mahi riverside and viaducts, 45+ toor dal mills, the ICAR soil & water research station, SVIT campus, the sacred mandir circuit — and the town's directory of shops, mills and PGs."
>
	<Nav />
	<main id="main">
		<h1 class="sr">Vasad — gateway to Charotar, Anand district, Gujarat</h1>

		<section class="hero wrap" aria-label="Vasad, painted on the town lorry">
			<LorryFlank />
			<div class="roadline" aria-hidden="true"></div>
			<div class="stones" aria-label="Distances and marks">
				<span class="stone stone--lacquer">Anand 15</span>
				<span class="stone stone--green">Vadodara 20</span>
				<span class="stone stone--mustard">Ahmedabad 75</span>
				<span class="stone stone--ghost">22.45°N · 73.0667°E</span>
				<span class="stone stone--ghost">18.89 m MSL</span>
			</div>
			<div class="actions">
				<a class="plate" href="#panchayat">Plan your visit</a>
				<a class="plate plate--ghost" href="/directory">Walk the directory</a>
			</div>
		</section>

		<section class="manifest wrap" aria-labelledby="manifest-h">
			<h2 id="manifest-h">What Vasad carries</h2>
			<p class="gu sub">વાસદનું ભથ્થું — the town’s load manifest</p>
			<ol class="lots">
				{
					lots.map((lot) => (
						<li class="lot">
							<span class="chip" aria-hidden="true">LOT {lot.no}</span>
							<span class="lotname">
								{lot.en} <span class="gu lotgu">{lot.gu}</span>
							</span>
							<span class="lotline">{lot.line}</span>
							<a class="lotlink" href={lot.href} aria-label={`${lot.en} — read below`}>
								↓
							</a>
						</li>
					))
				}
			</ol>
		</section>

		<section class="river" id="mahi" aria-labelledby="mahi-h">
			<div class="wrap">
				<h2 id="mahi-h">The northern shore of the Mahi</h2>
				<p class="gu sub">મહીસાગરનો ઉત્તરી તટ — the town kept its river for a front garden</p>
				<p class="measure">
					Vasad perches on the northern bluff of the Mahi at 18.89 metres, where the river’s
					old ravines — the <strong>kotars</strong> — cut into high alluvial terraces. Forest
					covers the south and northeast; the water runs on toward the Gulf of Khambhat. The
					railway has crossed here since the BB&CI era, masonry piers carrying passenger,
					MEMU and express trains over the riverbed, with NH 48 running the artery alongside.
				</p>
				<div class="riverline" role="img" aria-label="The Mahi’s course: Wanakbori dam upstream, the Vasad bluffs, and the Gulf of Khambhat estuary downstream">
					<svg viewBox="0 0 1200 130" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
						<path
							d="M20,70 C160,30 260,110 400,70 C540,30 640,110 780,70 C920,30 1020,110 1180,70"
							fill="none"
							stroke="#2a2723"
							stroke-width="4"
							stroke-dasharray="14 10"
						/>
						<circle cx="120" cy="58" r="9" fill="#e8a020" stroke="#2a2723" stroke-width="3.5" />
						<circle cx="600" cy="70" r="12" fill="#9e2b25" stroke="#2a2723" stroke-width="3.5" />
						<circle cx="1080" cy="58" r="9" fill="#1d5c3f" stroke="#2a2723" stroke-width="3.5" />
					</svg>
					<div class="stops">
						<span class="stop"><strong>Wanakbori Dam</strong> upstream reservoir</span>
						<span class="stop stop--mid"><strong>Vasad Bluffs</strong> 18.89 m · rail & NH 48 viaducts</span>
						<span class="stop"><strong>Gulf of Khambhat</strong> the river’s end</span>
					</div>
				</div>
			</div>
		</section>

		<section class="dal wrap" id="dal" aria-labelledby="dal-h">
			<h2 id="dal-h">The toor dal capital of Gujarat</h2>
			<p class="gu sub">ગુજરાતનું તુવેર દાળ કેન્દ્ર — the pulse pride of western India</p>
			<p class="measure intro">
				Vasad mills the pigeon pea the whole country eats. Over 45 facilities cure, temper,
				split and polish toor dal here — alongside tobacco floors and banana groves on the
				Mahi’s silt — and ship it to eighteen states and NRI kitchens abroad.
			</p>
			<div class="statrow">
				{dalStats.map((s) => (
					<div class="stat riveted">
						<span class="big">{s.big}</span>
						<span class="line">{s.line}</span>
					</div>
				))}
			</div>

			<h3 class="mid">The Vasad method</h3>
			<ol class="steps">
				{method.map((m) => (
					<li class="step">
						<span class="stepno" aria-hidden="true">{m.no}</span>
						<span class="stepen">{m.en}</span>
						<span class="stepline">{m.line}</span>
					</li>
				))}
			</ol>

			<h3 class="mid">The mill registry</h3>
			<p class="regnote">Regulated under the Anand APMC yard — seven boards of the forty-five:</p>
			<div class="ledger" role="table" aria-label="Mill registry">
				{
					registry.map((m) => (
						<div class="reg" role="row">
							<div class="regname" role="cell">
								<span class="en">{m.en}</span>
								<span class="gu">{m.gu}</span>
							</div>
							<div class="regmeta" role="cell">
								<span class="estd">Estd. {m.estd}</span>
								<span class="cap">{m.cap}</span>
							</div>
							<div class="regline" role="cell">
								{m.line}
								<span class="regmark">{m.mark}</span>
							</div>
						</div>
					))
				}
			</div>
			<div class="cta">
				<a class="plate" href="/directory">Buy Vasad dal — the directory</a>
				<span class="ctanote">Mill counters, retail marts and tariffs, board by board.</span>
			</div>
		</section>

		<section class="soil" id="soil" aria-labelledby="soil-h">
			<div class="wrap">
				<h2 id="soil-h">The ground, studied here</h2>
				<p class="gu sub">કેન્દ્રીય જમીન સંરક્ષણ અને જળ સંશોધન કેન્દ્ર — વાસદ</p>
				<p class="measure">
					Vasad hosts the ICAR–Indian Institute of Soil and Water Conservation’s research
					station, where the Mahi’s ravines were taught to hold still. The soil under the town
					reads in four layers, and the station’s three works hold every one of them in place.
				</p>
				<div class="soilgrid">
					<div class="strata panel" role="table" aria-label="Soil strata under Vasad">
						{
							strata.map((s, i) => (
								<div class:list={['band', `band--${i}`]}>
									<span class="depth">{s.depth}</span>
									<span class="bandtext">
										<strong>{s.en}</strong>
										{s.line}
									</span>
								</div>
							))
						}
					</div>
					<div class="pillars">
						{pillars.map((p) => (
							<div class="pillar">
								<span class="pno" aria-hidden="true">{p.no}</span>
								<span class="pen">{p.en}</span>
								<span class="pline">{p.line}</span>
							</div>
						))}
					</div>
				</div>
			</div>
		</section>

		<section class="campus wrap" id="campus" aria-labelledby="campus-h">
			<h2 id="campus-h">The campus on the riverbank</h2>
			<p class="gu sub">સરદાર વલ્લભભાઈ પટેલ ઇન્સ્ટિટ્યૂટ ઓફ ટેકનોલોજી — સ્થાપના ૧૯૯૭</p>
			<p class="measure intro">
				SVIT changed what this town is. Three colleges share the Mahi-side campus — engineering,
				architecture, nursing and computer applications — and its graduates now run works
				from Gujarat to Silicon Valley.
			</p>
			<div class="statrow">
				{campusStats.map((s) => (
					<div class="stat riveted">
						<span class="big">{s.big}</span>
						<span class="line">{s.line}</span>
					</div>
				))}
			</div>
			<div class="colleges">
				{colleges.map((c) => (
					<div class="college panel riveted">
						<span class="badge">{c.badge}</span>
						<span class="cen">{c.en}</span>
						<span class="cgu gu">{c.gu}</span>
						<span class="cline">{c.line}</span>
						<span class="cbody">{c.body}</span>
						<span class="cintake">{c.intake}</span>
					</div>
				))}
			</div>
			<blockquote class="creed">
				<p>“Educating minds where the historic waters of the Mahi meet the pioneering entrepreneurial spirit of Charotar.”</p>
				<cite>SVIT institutional creed · Vasad, Anand</cite>
			</blockquote>
			<div class="cta">
				<a class="plate plate--green" href="/study">Study at Vasad</a>
				<a class="plate plate--ghost" href="/directory#boys-pg">Student PGs &amp; hostels</a>
			</div>
		</section>

		<section class="landmarks" id="landmarks" aria-labelledby="landmarks-h">
			<div class="wrap">
				<h2 id="landmarks-h">Landmarks &amp; sacred roots</h2>
				<p class="gu sub">વાસદના સાંસ્કૃતિક અને ઐતિહાસિક સ્થાનો</p>
				<div class="landgrid">
					{landmarks.map((l) => (
						<div class:list={['land', 'panel', 'riveted', `land--${l.tone}`]}>
							<span class="len">{l.en}</span>
							<span class="lgu gu">{l.gu}</span>
							<span class="lline">{l.line}</span>
						</div>
					))}
				</div>
				<h3 class="mid">The mandir circuit</h3>
				<div class="mandirs">
					{mandirs.map((m) => (
						<div class="mandir">
							<span class="men">{m.en}</span>
							<span class="mgu gu">{m.gu}</span>
							<span class="mline">{m.line}</span>
						</div>
					))}
				</div>
				<h3 class="mid">Day trips from the gateway</h3>
				<div class="trips">
					{daytrips.map((t) => (
						<div class="trip">
							<span class="tkm">{t.km}</span>
							<span class="ten">{t.en}</span>
							<span class="tline">{t.line}</span>
							<span class="ttime">{t.time}</span>
						</div>
					))}
				</div>
			</div>
		</section>

		<section class="ethos" aria-labelledby="ethos-h">
			<div class="wrap">
				<h2 id="ethos-h">The Charotar temper</h2>
				<p class="measure">
					Charotar has always joined full fields to full schedules: families tend the fertile
					ground in the morning, run the mills through the day, and gather by the Mahi at
					dusk. Vasad is that temper in town form.
				</p>
				<div class="traits">
					{ethos.map((e) => (
						<div class="trait">
							<span class="tren">{e.en}</span>
							<span class="trline">{e.line}</span>
						</div>
					))}
				</div>
			</div>
		</section>

		<section class="panchayat wrap" id="panchayat" aria-labelledby="panch-h">
			<h2 id="panch-h">The panchayat desk</h2>
			<p class="gu sub">વાસદ ગ્રામ પંચાયત — civic administration and citizen services</p>
			<div class="panchgrid">
				<div class="panel riveted council">
					<h3>The elected council</h3>
					<dl class="ruled">
						{civicRows.map(([k, v]) => (
							<div class="row">
								<dt>{k}</dt>
								<dd>{v}</dd>
							</div>
						))}
					</dl>
				</div>
				<div class="statrow statrow--civic">
					{civicStats.map((s) => (
						<div class="stat riveted">
							<span class="big">{s.big}</span>
							<span class="line">{s.line}</span>
						</div>
					))}
				</div>
			</div>
			<div class="services">
				{services.map((s) => (
					<div class="service panel riveted">
						<span class="sen">{s.en}</span>
						<span class="sline">{s.line}</span>
						<span class="swhen">{s.when}</span>
					</div>
				))}
			</div>
			<h3 class="mid">Emergency lines</h3>
			<div class="emergency">
				{emergency.map((e) => (

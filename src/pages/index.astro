---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import LorryFlank from '../components/LorryFlank.astro';
import Map from '../components/Map.astro';

const dalStats = [
	{ big: '45+', line: 'processing mills in the Vasad cluster' },
	{ big: '1,200+ MT', line: 'daily pulse capacity across the yards' },
	{ big: '18 states + NRI', line: 'reach of Vasad dal, packed in Charotar' },
];

const method = [
	{ no: '01', en: 'Sun conditioning', line: 'Open-air solar drying on floor yards in the dry Charotar breeze.' },
	{ no: '02', en: 'Water tempering', line: 'Controlled moisture loosens the husk without cooking the kernel.' },
	{ no: '03', en: 'Emery dehusking', line: 'Low-friction stone mills split the pea with zero fracture loss.' },
	{ no: '04', en: 'Traditional coating', line: 'A castor-oil film locks in sweetness for twelve-month shelves.' },
];

const registry = [
	{ en: 'Laxmi Toor Dal Processing Works', gu: 'લક્ષ્મી તુવેર દાળ', estd: '1968', cap: '120 MT/day', line: 'Export-grade oiled & unpolished dal', mark: 'Flagship Vasad brand' },
	{ en: 'Delawala Grain & Pulse Mills', gu: 'ડેલાવાળા ગ્રેઇન એન્ડ પલ્સ', estd: '1964', cap: '55 MT/day', line: 'Hand-sorted Charotar toor dal', mark: 'Heritage pioneer' },
	{ en: 'Vasad Agro Industries', gu: 'વસાદ એગ્રો ઇન્ડસ્ટ્રીઝ', estd: '1978', cap: '80 MT/day', line: 'Golden sweet split pigeon peas', mark: 'High-volume producer' },
	{ en: 'Charotar Pulse Processors Co.', gu: 'ચારોતર પલ્સ પ્રોસેસર્સ', estd: '1983', cap: '65 MT/day', line: 'Castor-oiled dal — તેલવાળી તુવેર દાળ', mark: 'Export standard' },
	{ en: 'Shree Mahisagar Agro Mills', gu: 'શ્રી મહીસાગર એગ્રો મિલ્સ', estd: '1992', cap: '45 MT/day', line: 'Unpolished organic desi toor dal', mark: '100% unpolished' },
	{ en: 'Patel Brothers Pulse Corporation', gu: 'પટેલ બ્રધર્સ પલ્સ', estd: '1988', cap: '75 MT/day', line: 'Triple-cleaned bold-grain split dal', mark: 'Pan-India distributor' },
];

const strata = [
	{ depth: '0.0 – 0.6 m', en: 'Charotar goradu loam', line: 'Nutrient-rich sandy loam — the taproot bed of dal and tobacco.' },
	{ depth: '0.6 – 3.5 m', en: 'Calcareous silt & kankar', line: 'Dense subsoil that gullies fast once cover is stripped.' },
	{ depth: '3.5 – 12 m', en: 'Kotar ravine terraces', line: 'Held by contour bunding, check dams and root nets.' },
	{ depth: '12 m +', en: 'Mahi fluvial sands', line: 'The recharge zone feeding wells and borewells.' },
];

const landmarks = [
	{ en: 'Art of Living Gujarat Ashram', gu: 'આર્ટ ઓફ લિવિંગ આશ્રમ', line: 'Residential Sudarshan Kriya retreats, silent sits and youth courses in greenery over the northern bank.', tone: 'lacquer' },
	{ en: 'The 200-Year Banyan', gu: 'ઇતિહાસિક વડ વૃક્ષ', line: 'Two centuries of prop roots beside the Mahadev mandir — the town’s living guardian.', tone: 'green' },
	{ en: 'Krishna Riverside Resort', gu: 'કૃષ્ણા રિવરસાઇડ રિસોર્ટ', line: 'River-cliff nature trails, open lawns, water adventure and Charotar Kathiyawadi dining.', tone: 'mustard' },
	{ en: 'Vasad Junction (VDA)', gu: 'વાસદ જંકશન', line: 'Western Railway node on the Mumbai–Ahmedabad trunk — passengers, MEMU and express over the viaduct.', tone: 'green' },
];

const ethos = [
	{ en: 'Dialect & script', line: 'Proud Charotari Gujarati, with literary and mercantile roots.' },
	{ en: 'Community', line: 'Patidars, artisans, traders and scholars across 3,047 households.' },
	{ en: 'Hospitality', line: 'Charotar warmth for travellers on the old trunk highway.' },
	{ en: 'Rhythm', line: 'Fields at morning, mills by day, the Mahi’s bank at dusk.' },
];
---

<Layout
	title="Vasad — Gateway to Charotar | વાસદ"
	description="Vasad (Vasudhanagari), Anand district, Gujarat: the Mahi riverside and viaducts, 45+ toor dal mills, the ICAR soil & water research station, SVIT campus, the sacred mandir circuit — and the town's directory of shops, mills and PGs."
>
	<Nav />
	<main id="main">
		<h1 class="sr-only">Vasad — gateway to Charotar, Anand district, Gujarat</h1>

		<section class="pt-9" aria-label="Vasad, painted on the town lorry">
			<div class="wrap">
				<LorryFlank />
			</div>
			<div class="h-[14px] animate-drift border-y-[3px] border-ink bg-[repeating-linear-gradient(90deg,var(--color-mustard)_0_84px,var(--color-ink)_84px_118px)]" aria-hidden="true"></div>
			<div class="wrap">
				<div class="mt-6 flex flex-wrap gap-4">
					<a class="plate" href="/visit">Plan your visit</a>
					<a class="plate plate-ghost" href="/directory">Walk the directory</a>
				</div>
			</div>
		</section>

		<section class="mt-20 border-y-[3px] border-ink bg-green py-14 text-cream" id="mahi" aria-label="The northern shore of the Mahi">
			<div class="wrap">
				<h2 class="text-[clamp(1.9rem,4vw,2.7rem)] text-mustard">The northern shore of the Mahi</h2>
				<p class="font-gu mt-1.5 text-cream/80">મહીસાગરનો ઉત્તરી તટ — the town kept its river for a front garden</p>
				<p class="mt-4">
					Vasad perches on the northern bluff of the Mahi, where the river’s old ravines —
					the <strong>kotars</strong> — cut into high alluvial terraces and the water runs
					on toward the Gulf of Khambhat.
				</p>
				<div class="mt-10" role="img" aria-label="The Mahi’s course: Wanakbori dam upstream, the Vasad bluffs, and the Gulf of Khambhat estuary downstream">
					<svg class="block h-auto w-full" viewBox="0 0 1200 130" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
						<path
							d="M20,70 C160,30 260,110 400,70 C540,30 640,110 780,70 C920,30 1020,110 1180,70"
							fill="none"
							stroke="#2a2723"
							stroke-width="4"
							stroke-dasharray="14 10"
						/>
						<circle cx="120" cy="58" r="9" fill="#e8a020" stroke="#2a2723" stroke-width="3.5"></circle>
						<circle cx="600" cy="70" r="12" fill="#9e2b25" stroke="#2a2723" stroke-width="3.5"></circle>
						<circle cx="1080" cy="58" r="9" fill="#1d5c3f" stroke="#2a2723" stroke-width="3.5"></circle>
					</svg>
					<div class="mt-3 flex flex-wrap justify-between gap-4">
						<span class="min-w-44 flex-1 text-[0.95rem] text-cream/85">
							<strong class="block font-display text-[1.15rem] font-normal text-cream">Wanakbori Dam</strong>
							upstream reservoir
						</span>
						<span class="min-w-44 flex-1 text-[0.95rem] text-cream/85">
							<strong class="block font-display text-[1.15rem] font-normal text-mustard">Vasad Bluffs</strong>
							18.89 m · rail &amp; NH 48 viaducts
						</span>
						<span class="min-w-44 flex-1 text-[0.95rem] text-cream/85">
							<strong class="block font-display text-[1.15rem] font-normal text-cream">Gulf of Khambhat</strong>
							the river’s end
						</span>
					</div>
				</div>
			</div>
		</section>

		<section class="wrap mt-20" id="map-teaser" aria-label="Vasad on the map">
			<Map variant="teaser" zoom={12} />
		</section>

		<section class="wrap mt-20" id="dal" aria-label="The toor dal capital of Gujarat">
			<h2 class="text-[clamp(1.9rem,4vw,2.7rem)]">The toor dal capital of Gujarat</h2>
			<p class="font-gu mt-1.5 text-ink/80">ગુજરાતનું તુવેર દાળ કેન્દ્ર — the pulse pride of western India</p>
			<p class="mt-4 max-w-[68ch]">
				Vasad mills the pigeon pea the whole country eats. Over 45 facilities cure, temper,
				split and polish toor dal here — alongside tobacco floors and banana groves on the
				Mahi’s silt — and ship it to eighteen states and NRI kitchens abroad.
			</p>
			<div class="mt-9 grid grid-cols-[repeat(auto-fit,minmax(190px,1fr))] gap-6">
				{
					dalStats.map((s) => (
						<div class="panel riveted flex flex-col gap-0.5 px-6 py-5">
							<span class="font-display text-[2rem] text-lacquer">{s.big}</span>
							<span class="text-[0.95rem] text-ink/85">{s.line}</span>
						</div>
					))
				}
			</div>

			<h3 class="mt-12 text-2xl">The Vasad method</h3>
			<ol class="mt-6 grid list-none grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-6 p-0">
				{
					method.map((m, idx) => (
						<li
							class:list={[
								'flex flex-col gap-1 rounded-xl border-[3px] border-ink px-6 py-5 shadow-paint',
								idx === 1 ? 'bg-lacquer text-cream' : idx === 2 ? 'bg-mustard text-ink' : 'bg-green text-cream',
							]}
						>
							<span
								class:list={[
									'font-display text-[1.9rem]',
									idx === 2 ? 'text-lacquer' : 'text-mustard',
								]}
								aria-hidden="true"
							>
								{m.no}
							</span>
							<span class="font-display text-[1.25rem]">{m.en}</span>
							<span class="text-[0.95rem] leading-[1.5] opacity-92">{m.line}</span>
						</li>
					))
				}
			</ol>

			<h3 class="mt-12 text-2xl">The mill registry</h3>
			<p class="mt-2 text-ink/80">Regulated under the Anand APMC yard — seven boards of the forty-five:</p>
			<div class="mt-6 border-t-[3px] border-ink" role="table" aria-label="Mill registry">
				{
					registry.map((m) => (
						<div
							class="grid items-center gap-x-6 gap-y-1 border-b-[3px] border-ink px-1 py-4 [grid-template-columns:1.35fr_0.55fr_1.1fr] max-[780px]:grid-cols-1 [transition:background-color_0.25s_ease-out,transform_0.25s_ease-out] hover:translate-x-1.5 hover:bg-lacquer/8"
							role="row"
						>
							<div role="cell">
								<span class="block font-display text-[1.2rem]">{m.en}</span>
								<span class="font-gu block text-[0.9rem] font-semibold text-lacquer">{m.gu}</span>
							</div>
							<div class="flex flex-col" role="cell">
								<span class="text-[0.85rem] text-ink/70">Estd. {m.estd}</span>
								<span class="font-display text-[1.05rem]">{m.cap}</span>
							</div>
							<div class="text-[0.95rem] text-ink/85" role="cell">
								{m.line}
								<span class="mt-0.5 block font-display text-[0.85rem] text-green">{m.mark}</span>
							</div>
						</div>
					))
				}
			</div>
			<div class="mt-10 flex flex-wrap items-center gap-5">
				<a class="plate" href="/directory">Buy Vasad dal — the directory</a>
				<span class="text-[0.95rem] text-ink/75">Mill counters, retail marts and tariffs, board by board.</span>
			</div>
		</section>

		<section class="mt-20 border-y-[3px] border-ink bg-cream-hi py-14" id="soil" aria-label="The ground, studied here">
			<div class="wrap">
				<h2 class="text-[clamp(1.9rem,4vw,2.7rem)]">The ground, studied here</h2>
				<p class="font-gu mt-1.5 text-ink/80">કેન્દ્રીય જમીન સંરક્ષણ અને જળ સંશોધન કેન્દ્ર — વાસદ</p>
				<p class="mt-4 max-w-[68ch]">
					Vasad hosts the ICAR–Indian Institute of Soil and Water Conservation’s research
					station, where the Mahi’s ravines were taught to hold still. The soil under the
					town reads in four layers.
				</p>
				<div class="mt-10 grid items-start gap-10 lg:grid-cols-[1.1fr_1fr]">
					<div class="panel overflow-hidden" role="table" aria-label="Soil strata under Vasad">
						{
							strata.map((s, idx) => (
								<div
									class:list={[
										'grid grid-cols-[7.5rem_1fr] gap-4 border-b-[3px] border-ink px-5 py-4 last:border-b-0',
										idx === 0 && 'bg-cream text-ink',
										idx === 1 && 'bg-mustard/28 text-ink',
										idx === 2 && 'bg-green text-cream',
										idx === 3 && 'bg-ink text-cream',
									]}
								>
									<span class="font-display text-[0.95rem]">{s.depth}</span>
									<span class="text-[0.93rem] leading-[1.45]">
										<strong class="mb-0.5 block font-display text-[1.05rem] font-normal">{s.en}</strong>
										{s.line}
									</span>
								</div>
							))
						}
					</div>
					<div class="flex flex-col items-start gap-6">
						<p class="max-w-[46ch]">
							Contour bunding, check dams and bamboo plantations hold every one of these
							layers in place — the station’s three works, pioneered on these ravines.
						</p>
						<a class="plate plate-green" href="/study#research">The station’s three works</a>
					</div>
				</div>
			</div>
		</section>

		<section class="wrap mt-20" id="campus" aria-label="The campus on the riverbank">
			<h2 class="text-[clamp(1.9rem,4vw,2.7rem)]">The campus on the riverbank</h2>
			<p class="font-gu mt-1.5 text-ink/80">સરદાર વલ્લભભાઈ પટેલ ઇન્સ્ટિટ્યૂટ ઓફ ટેકનોલોજી — સ્થાપના ૧૯૯૭</p>
			<p class="mt-4 max-w-[68ch]">
				SVIT changed what this town is. Three colleges share the Mahi-side campus — engineering,
				architecture, nursing and computer applications — and its graduates now run works
				from Gujarat to Silicon Valley.
			</p>
			<div class="mt-10 flex flex-wrap items-center gap-5">
				<a class="plate plate-green" href="/study">Study at Vasad</a>
				<a class="plate plate-ghost" href="/directory#boys-pg">Student PGs &amp; hostels</a>
			</div>
		</section>

		<section class="mt-20 border-y-[3px] border-ink bg-green py-14 text-cream" id="landmarks" aria-label="Landmarks &amp; sacred roots">
			<div class="wrap">
				<h2 class="text-[clamp(1.9rem,4vw,2.7rem)] text-mustard">Landmarks &amp; sacred roots</h2>
				<p class="font-gu mt-1.5 text-cream/80">વાસદના સાંસ્કૃતિક અને ઐતિહાસિક સ્થાનો</p>
				<div class="mt-9 grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-6">
					{landmarks.map((l) => (
						<div
							class:list={[
								'panel riveted flex flex-col gap-1 px-6 py-6',
								l.tone === 'lacquer' && 'bg-lacquer text-cream',
								l.tone === 'green' && 'bg-green-deep text-cream',
								l.tone === 'mustard' && 'bg-mustard text-ink',
							]}
						>
							<span class="font-display text-[1.35rem]">{l.en}</span>
							<span class="font-gu text-[0.92rem] font-semibold opacity-90">{l.gu}</span>
							<span class="mt-1.5 text-[0.95rem] leading-[1.5]">{l.line}</span>
						</div>
					))}
				</div>
				<div class="mt-10 flex flex-wrap items-center gap-5">
					<a class="plate" href="/visit">The sacred circuit &amp; day trips</a>
					<span class="text-[0.95rem] text-cream/75">Six mandirs around the 200-year banyan, and the gateway distances.</span>
				</div>
			</div>
		</section>

		<section class="mt-20 bg-ink py-14 text-cream" aria-label="The Charotar temper">
			<div class="wrap">
				<h2 class="text-[clamp(1.9rem,4vw,2.7rem)] text-mustard">The Charotar temper</h2>
				<p class="mt-4 max-w-[68ch] text-cream/90">
					Charotar has always joined full fields to full schedules: families tend the fertile
					ground in the morning, run the mills through the day, and gather by the Mahi at
					dusk. Vasad is that temper in town form.
				</p>
				<div class="mt-9 grid grid-cols-[repeat(auto-fit,minmax(210px,1fr))] gap-6">
					{ethos.map((e) => (
						<div class="rounded-[10px] border-[2.5px] border-cream/40 px-5 py-4">
							<span class="block font-display text-lg text-mustard">{e.en}</span>
							<span class="mt-0.5 block text-[0.92rem] text-cream/85">{e.line}</span>
						</div>
					))}
				</div>
			</div>
		</section>

		<section class="wrap mt-20" id="panchayat" aria-label="The panchayat desk">
			<h2 class="text-[clamp(1.9rem,4vw,2.7rem)]">The panchayat desk</h2>
			<p class="font-gu mt-1.5 text-ink/80">વાસદ ગ્રામ પંચાયત — civic administration and citizen services</p>
			<p class="mt-4 max-w-[68ch]">
				The elected gram panchayat runs the town’s counters — water, sanitation, civil
				registries and land records — from the Panchayat Bhavan, with emergency lines for
				health, police, power and rail.
			</p>
			<div class="mt-10 flex flex-wrap items-center gap-5">
				<a class="plate" href="/contact">The panchayat office</a>
				<span class="text-[0.95rem] text-ink/75">The council, service counters and emergency phone lines.</span>
			</div>
		</section>
	</main>
	<Footer />
</Layout>

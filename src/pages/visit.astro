---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const mandirs = [
	{ en: 'Mahadev Mandir', gu: 'મહાદેવ', line: 'Riverside shivalaya beside the 200-year banyan.' },
	{ en: 'Veharai Mata Mandir', gu: 'વેહરાઈ માતા', line: 'Kuldevi shrine of Charotar Patidar households.' },
	{ en: 'Jalaram Mandir', gu: 'જલારામ બાપા', line: 'Daily sadavrat and devotional gatherings.' },
	{ en: 'Swaminarayan Mandir', gu: 'સ્વામિનારાયણ', line: 'Shikharbaddh sanctum with youth assemblies.' },
	{ en: 'Sat Kaival Mandir', gu: 'સત કૈવલ', line: 'Kaival gyan philosophy and hymns.' },
	{ en: 'Ram Mandir', gu: 'રામ મંદિર', line: 'Ram Navami processions from the village heart.' },
];

const daytrips = [
	{ en: 'Vadodara (Baroda)', km: '20 km', line: 'Laxmi Vilas Palace, Kirti Mandir, Sayaji Baug', time: '25 min down NH 48' },
	{ en: 'Dakor', km: '35 km', line: 'Shree Ranchhodraiji Mandir and the sacred Gomti lake', time: '40 min via Anand–Umreth' },
	{ en: 'Champaner-Pavagadh', km: '65 km', line: 'UNESCO World Heritage site and Kalika Mata temple', time: '1 hr 15 via Halol' },
	{ en: 'Statue of Unity', km: '105 km', line: 'The world’s tallest monument at 182 m and Sardar Sarovar', time: '2 hrs via Vadodara–Dabhoi' },
];

const stones = [
	{ gu: 'આણંદ', en: 'Anand 15', tone: 'bg-lacquer text-cream' },
	{ gu: 'વડોદરા', en: 'Vadodara 20', tone: 'bg-green text-cream' },
	{ gu: 'અમદાવાદ', en: 'Ahmedabad 75', tone: 'bg-mustard text-ink' },
	{ gu: 'મુંબઈ', en: 'Mumbai 420', tone: 'bg-cream text-ink' },
];
---

<Layout
	title="Reach & Roam — Vasad | પ્રવાસ"
	description="Visiting Vasad: the Mahi bluffs and viaducts, the Art of Living ashram, Krishna Riverside Resort, the 200-year banyan and six mandirs, and day trips from NH 48."
>
	<Nav />
	<main id="main" class="wrap">
		<header class="pt-12">
			<h1 class="text-[clamp(2.3rem,5vw,3.4rem)]">Reach &amp; roam</h1>
			<p class="font-gu mt-1.5 text-[1.1rem] text-ink/80">પ્રવાસ — the river, the retreats, the sacred circuit</p>
		</header>

		<section class="panel riveted mt-10 bg-green px-8 pb-8 pt-8 text-cream" aria-label="The Mahi at the town’s edge">
			<h2 class="text-[clamp(1.7rem,3.2vw,2.3rem)] text-mustard">The Mahi at the town’s edge</h2>
			<p class="mt-3">
				Vasad perches on the northern bluff of the Mahi at 18.89 metres — the old ravine
				terrace the locals call the <strong>kotar</strong>. Forested cliffs run south and
				northeast, the evening air comes off the water, and the railway’s masonry viaduct
				piers carry the Mumbai–Ahmedabad trains across the bed. No ticket, no gate — just the
				bank.
			</p>
		</section>

		<div class="grid items-start gap-10 md:grid-cols-[1.2fr_1fr]">
			<section class="panel riveted -rotate-[0.6deg] mt-10 bg-lacquer px-8 pb-8 pt-8 text-cream" aria-label="Art of Living Gujarat Ashram">
				<h2 class="text-[clamp(1.6rem,3vw,2.1rem)]">Art of Living Gujarat Ashram</h2>
				<p class="font-gu mt-0.5 text-[0.95rem] font-semibold text-cream/80">આર્ટ ઓફ લિવિંગ ગુજરાત આશ્રમ — વાસદ</p>
				<p class="mt-2.5">
					The foundation’s Gujarat ashram, set in greenery over the northern bank. Residential
					Sudarshan Kriya retreats, silent meditation and youth empowerment courses, with
					daily satsangs and a yoga amphitheatre. Check the ashram’s own calendar before
					travelling for a specific program.
				</p>
			</section>
			<section class="panel riveted mt-10 rotate-[0.8deg] bg-green px-8 pb-8 pt-8 text-cream" aria-label="Krishna Riverside Resort">
				<h2 class="text-[clamp(1.6rem,3vw,2.1rem)]">Krishna Riverside Resort</h2>
				<p class="font-gu mt-0.5 text-[0.95rem] font-semibold text-cream/80">ક્રિષ્ના રિવરસાઇડ રિસોર્ટ</p>
				<p class="mt-2.5">
					Hospitality and recreation on the river cliffs — nature trails along the bluffs,
					open lawns, water adventure, and Charotar Kathiyawadi dining. Riverfront cottages
					with the Mahi for a neighbour.
				</p>
			</section>
		</div>

		<section class="panel riveted mt-10 bg-cream-hi px-8 pb-8 pt-8" aria-label="Sacred roots">
			<h2 class="text-[clamp(1.7rem,3.2vw,2.3rem)]">Sacred roots</h2>
			<p class="mt-3">
				Beside the Mahadev mandir on the old bluff stands the town’s living guardian — a
				<strong>200-year-old banyan</strong>, its prop roots descending like pillars. Around
				it runs the mandir circuit of six:
			</p>
			<div class="mt-6 grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-5">
				{mandirs.map((m) => (
					<div class="rounded-[10px] border-[2.5px] border-ink/50 bg-cream px-4 py-4">
						<span class="block font-display text-[1.08rem]">{m.en}</span>
						<span class="font-gu block text-[0.85rem] font-semibold text-lacquer">{m.gu}</span>
						<span class="mt-1 block text-[0.85rem] text-ink/85">{m.line}</span>
					</div>
				))}
			</div>
		</section>

		<section class="panel riveted mt-10 bg-cream-hi px-8 pb-8 pt-8" id="reach" aria-label="Getting there">
			<h2 class="text-[clamp(1.7rem,3.2vw,2.3rem)]">Getting there</h2>
			<div class="mt-4 grid gap-8 md:grid-cols-2">
				<div>
					<h3 class="mb-1.5 font-display text-[1.25rem] font-normal">Road</h3>
					<p>
						Vasad sits on <strong>NH 48</strong>, the Ahmedabad–Vadodara artery. Anand lies
						15 km north, Vadodara 20 km south, Ahmedabad 75 km, Mumbai 420 km.
					</p>
				</div>
				<div>
					<h3 class="mb-1.5 font-display text-[1.25rem] font-normal">Rail</h3>
					<p>
						<strong>Vasad Junction (station code VDA)</strong> halts passenger, MEMU and
						selected express trains on the Western Railway trunk — about 15 km from Anand
						Junction, over the river viaduct.
					</p>
				</div>
			</div>
			<div class="mt-6 flex flex-wrap gap-3" aria-label="Distances">
				{
					stones.map((s) => (
						<span class:list={['rounded-t-[10px] rounded-b-[4px] border-[3px] border-ink px-4 pt-1 pb-1.5 font-display text-base shadow-paint', s.tone]}>
							<span class="font-gu mr-[0.3rem] text-[0.95em] opacity-90">{s.gu}</span> {s.en}
						</span>
					))
				}
			</div>
		</section>

		<section class="panel riveted mt-10 bg-cream-hi px-8 pb-8 pt-8" aria-label="The gateway for day trips">
			<h2 class="text-[clamp(1.7rem,3.2vw,2.3rem)]">The gateway for day trips</h2>
			<p class="mt-3">
				Midway on the corridor, Vasad is the unhurried base for central Gujarat’s celebrated
				destinations:
			</p>
			<div class="mt-6 grid grid-cols-[repeat(auto-fit,minmax(230px,1fr))] gap-6">
				{daytrips.map((t) => (
					<div class="flex flex-col gap-0.5 rounded-t-[10px] rounded-b-[4px] border-[3px] border-ink bg-cream px-5 py-5 shadow-paint">
						<span class="font-display text-[1.6rem] text-lacquer">{t.km}</span>
						<span class="font-display text-[1.15rem]">{t.en}</span>
						<span class="text-[0.9rem] text-ink/85">{t.line}</span>
						<span class="mt-1.5 text-[0.85rem] font-semibold text-green">{t.time}</span>
					</div>
				))}
			</div>
		</section>

		<section class="mt-9 text-[1.05rem]" aria-label="Where to stay">
			<p>
				Lodging, PGs and messes hang their boards on the {' '}
				<a href="/directory">directory wall</a>.
			</p>
		</section>
	</main>
	<Footer />
</Layout>

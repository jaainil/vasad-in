---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const ground = [
	['Bank', 'The northern bluff of the Mahi river, 18.89 m above sea level'],
	['Road', 'On NH 48, between Ahmedabad (75 km) and Vadodara (20 km)'],
	['District', 'Anand seat lies 15 km to the north'],
	['Woods', 'Forests to the south and the northeast, over kotar ravines'],
	['Position', '22.45°N 73.0667°E'],
];

const people = [
	['People', '14,384 at the 2011 Census'],
	['Men & women', '7,530 men · 6,854 women'],
	['Households', '3,047 — sex ratio 910 women per 1,000 men'],
	['Literacy', '80.12% — men 84.18%, women 75.66%'],
	['Languages', 'Gujarati and Hindi at home, English in class'],
];

const work = [
	['Dal', '45+ toor dal processing mills — the pulse capital of Gujarat'],
	['Fields', 'Tobacco floors and banana groves on the Mahi’s silt'],
	['Research', 'The ICAR soil & water conservation station on the ravines'],
];

const civic = [
	['Body', 'Gram panchayat Vasad'],
	['Constituencies', 'Anklav Vidhan Sabha · Anand Lok Sabha'],
	['Post', 'PIN 388306 · STD code 02692'],
];
---

<Layout
	title="The Town Record — Vasad | વાસદ વિશે"
	description="Vasad's record: Vasudhanagari, the northern bluff of the Mahi, the 2011 Census people, the dal-mill economy, and the gram panchayat."
>
	<Nav />
	<main id="main" class="wrap">
		<header class="pt-12">
			<h1 class="text-[clamp(2.3rem,5vw,3.4rem)]">The town record</h1>
			<p class="gu mt-1.5 text-[1.1rem] text-ink/80">વાસદ વિશે — what the registers say</p>
		</header>

		<section class="panel riveted mt-10 bg-cream-hi px-8 pb-8 pt-8" aria-labelledby="name-h">
			<h2 id="name-h" class="text-[clamp(1.8rem,3.5vw,2.5rem)]">Vasad · <span class="gu">વાસદ</span></h2>
			<p class="measure mt-3">
				The registers record an older name too: <strong>Vasudhanagari</strong> — from the
				Sanskrit <em>vasudha</em>, the earth and its treasure, and <em>nagari</em>, the city.
				The town sits in Anand district, Gujarat, and calls itself the gateway to Charotar —
				the rich, double-cropped plain between the Mahi and the Sabarmati.
			</p>
		</section>

		<div class="grid gap-10 md:grid-cols-2">
			<section class="panel riveted mt-10 px-8 pb-8 pt-8" aria-labelledby="ground-h">
				<h2 class="text-[1.7rem]">The ground</h2>
				<dl class="mt-4">
					{ground.map(([k, v]) => (
						<div class="row">
							<dt>{k}</dt>
							<dd>{v}</dd>
						</div>
					))}
				</dl>
			</section>
			<section class="panel riveted mt-10 bg-lacquer px-8 pb-8 pt-8 text-cream" aria-labelledby="people-h">
				<h2 class="text-[1.7rem]">The people</h2>
				<dl class="mt-4">
					{people.map(([k, v]) => (
						<div class="row row-light">
							<dt>{k}</dt>
							<dd>{v}</dd>
						</div>
					))}
				</dl>
			</section>
		</div>

		<div class="grid gap-10 md:grid-cols-2">
			<section class="panel riveted mt-10 bg-green px-8 pb-8 pt-8 text-cream" aria-labelledby="work-h">
				<h2 class="text-[1.7rem]">The work</h2>
				<dl class="mt-4">
					{work.map(([k, v]) => (
						<div class="row row-light">
							<dt>{k}</dt>
							<dd>{v}</dd>
						</div>
					))}
				</dl>
				<a class="plate plate-ghost mt-6 px-5 py-2.5 text-base" href="/directory">Walk the mill yard</a>
			</section>
			<section class="panel riveted mt-10 bg-mustard px-8 pb-8 pt-8 text-ink" aria-labelledby="civic-h">
				<h2 class="text-[1.7rem]">The civic</h2>
				<dl class="mt-4">
					{civic.map(([k, v]) => (
						<div class="row">
							<dt>{k}</dt>
							<dd>{v}</dd>
						</div>
					))}
				</dl>
				<a class="plate mt-6 px-5 py-2.5 text-base" href="/contact">The panchayat office</a>
			</section>
		</div>
	</main>
	<Footer />
</Layout>

<style>
	.row {
		display: grid;
		grid-template-columns: 8.5rem 1fr;
		gap: 0.8rem;
		padding: 0.7rem 0;
		border-bottom: 2px dashed color-mix(in srgb, var(--color-ink) 40%, transparent);
	}
	.row:last-child {
		border-bottom: 0;
	}
	.row-light {
		border-bottom-color: color-mix(in srgb, var(--color-cream) 40%, transparent);
	}
	dt {
		font-family: var(--font-display);
		font-size: 1.02rem;
	}
	dd {
		margin: 0;
		line-height: 1.5;
	}
</style>
